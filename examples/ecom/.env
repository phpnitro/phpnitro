APP_NAME="Ma Boutique"
APP_DEBUG=true

# Paiement — /checkout choisit UN SEUL gateway, le premier configuré dans
# cet ordre (voir CheckoutPage::selectPaymentWidget()). Tout laisser
# commenté = mode démo (validation de commande sans paiement réel).
# Renseigne la clé publique/shop id pour afficher le vrai bouton ; la clé
# secrète/privée n'est nécessaire que pour activer la vérification
# serveur-à-serveur (voir phpnitro.yml et README.md#paiement-kkiapay).

# 1. Kkiapay
# KKIAPAY_PUBLIC_KEY="ta_cle_publique_sandbox"
# KKIAPAY_PRIVATE_KEY="ta_cle_privee_sandbox"

# 2. PayPal
# PAYPAL_CLIENT_ID="ton_client_id_sandbox"
# PAYPAL_CLIENT_SECRET="ton_client_secret_sandbox"

# 3. FedaPay
# FEDAPAY_PUBLIC_KEY="ta_cle_publique_sandbox"
# FEDAPAY_SECRET_KEY="ta_cle_secrete_sandbox"

# 4. Stripe — secrète seule = redirection hébergée (StripeButton, aucune
#    clé publique nécessaire) ; les deux clés = champ carte intégré
#    (StripeCardField, Stripe Elements) à la place.
# STRIPE_PUBLIC_KEY="ta_cle_publique_sandbox"
# STRIPE_SECRET_KEY="ta_cle_secrete_sandbox"

# 5. Feexpay — vérification serveur non implémentée, voir FeexpayButton
# FEEXPAY_SHOP_ID="ton_shop_id"
# FEEXPAY_API_KEY="ta_cle_api"

# 6. iZiChangePay — vérification serveur non implémentée, voir IziChangePayButton
# IZICHANGEPAY_API_KEY="ta_cle_api"
# IZICHANGEPAY_API_SECRET="ta_cle_secrete"

# 7. TresorPay — widget non vérifié (voir TresorPayButton), vérification serveur non implémentée
# TRESORPAY_PUBLIC_KEY="ta_cle_publique"
# TRESORPAY_SECRET_KEY="ta_cle_secrete"
