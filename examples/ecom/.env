APP_NAME="Ma Boutique"
APP_DEBUG=true

# Paiement Kkiapay — laisse les deux commentées pour rester en mode démo
# (validation de commande sans paiement réel). Renseigne ta clé publique
# sandbox pour afficher le vrai bouton Kkiapay ; la clé privée n'est
# nécessaire que pour activer la vérification serveur-à-serveur (voir
# CheckoutPage::verifyKkiapayTransaction()).
# KKIAPAY_PUBLIC_KEY="ta_cle_publique_sandbox"
# KKIAPAY_PRIVATE_KEY="ta_cle_privee_sandbox"
