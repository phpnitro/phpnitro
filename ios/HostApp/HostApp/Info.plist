<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phpnitro</string>
			</array>
		</dict>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>alt</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon-Alt</string>
				</array>
			</dict>
		</dict>
	</dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Lit l'état du Bluetooth pour la démo NativeDeviceBridge.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Compte les événements à venir pour la démo NativeDeviceBridge — lecture seule.</string>
	<key>NSCameraUsageDescription</key>
	<string>Démo de demande de permission caméra (NativeDeviceBridge).</string>
	<key>NSContactsUsageDescription</key>
	<string>Compte les contacts pour la démo NativeDeviceBridge — lecture seule.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Confirme ton identité pour la démo NativeDeviceBridge.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Lit le nombre de pas du jour pour la démo NativeDeviceBridge — lecture seule.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Démo de demande de permission de localisation (NativeDeviceBridge).</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Démo de demande de permission microphone (NativeDeviceBridge).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choisit une image à recadrer pour la démo NativeDeviceBridge.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.phpnitro.hostapp.ping</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shareddocuments</string>
	</array>
</dict>
</plist>
