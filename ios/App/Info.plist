<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>UILaunchStoryboardName</key>
    <string></string>

    <!-- Same device capabilities as Android (Device\Vibrate has no iOS
         permission — see WebAppInterface.swift's vibrate() comment;
         LocationButton/Device\Camera/Device\Microphone do need one each).
         Device\ImagePicker (PHPickerViewController) deliberately needs NO
         NSPhotoLibraryUsageDescription — see WebAppInterface.swift's
         pickImage() comment on why iOS 14+'s picker doesn't require it. -->
    <key>NSCameraUsageDescription</key>
    <string>Camera access is used by Engine\Device\Camera in your PHP screens.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Microphone access is used by Engine\Device\Microphone in your PHP screens.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Location access is used by LocationButton widgets in your PHP screens.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Face ID is used by Engine\Device\Fingerprint to confirm your identity in your PHP screens.</string>

    <!-- Equivalent of android:usesCleartextTraffic="true" — allows plain HTTP
         to the local PHP server during development. Restrict this before a
         real App Store submission. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
