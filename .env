APP_NAME="Mobile App"
APP_DEBUG=true

# SQLite par défaut si DATABASE_URL n'est pas défini (fichier backend/var/data.sqlite).
# Pour MySQL ou PostgreSQL, décommente une des lignes suivantes (Doctrine DBAL gère les trois) :
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname"
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/dbname"
