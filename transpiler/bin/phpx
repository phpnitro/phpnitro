#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Transpiler\DartEmitter;
use Transpiler\FlutterProjectGenerator;
use Transpiler\Parser;
use Transpiler\PubspecDependencyWriter;
use Transpiler\ScreenExtractor;

function phpxFail(string $message): never
{
    fwrite(STDERR, "phpx: {$message}\n");
    exit(1);
}

function passthruOrFail(string $command): void
{
    passthru($command, $exitCode);
    if ($exitCode !== 0) {
        phpxFail("command failed ({$exitCode}): {$command}");
    }
}

function homePageTemplate(): string
{
    return <<<'PHP'
    <?php

    use Sdk\StatelessWidget;
    use Sdk\Widget;
    use Sdk\Column;
    use Sdk\Text;
    use Sdk\Button;

    class HomePage extends StatelessWidget
    {
        public function build(): Widget
        {
            return Column::new([
                Text::new('Mon application'),
                Button::new('Connexion'),
            ]);
        }
    }

    PHP;
}

function phpxJsonTemplate(): string
{
    return <<<'JSON'
    {
        "dependencies": {}
    }

    JSON;
}

function cmdCreate(string $name): void
{
    $projectDir = getcwd() . '/' . $name;
    $appDir = $projectDir . '/app';

    if (is_dir($projectDir)) {
        phpxFail("directory already exists: {$projectDir}");
    }

    mkdir($appDir, 0777, true);
    file_put_contents($appDir . '/HomePage.php', homePageTemplate());
    file_put_contents($projectDir . '/phpx.json', phpxJsonTemplate());

    echo "Created {$appDir}/HomePage.php\n";
    echo "Created {$projectDir}/phpx.json\n";
    echo "Running flutter create...\n";

    $packageName = strtolower(preg_replace('/[^a-zA-Z0-9]+/', '_', basename($name))) . '_app';

    passthruOrFail(
        'flutter create --project-name ' . escapeshellarg($packageName) . ' '
        . escapeshellarg($projectDir . '/.flutter')
    );

    echo "Project created at {$projectDir}\n";
}

/**
 * @return array<string, string>
 */
function readDependencies(string $projectDir): array
{
    $phpxJsonPath = $projectDir . '/phpx.json';

    if (!is_file($phpxJsonPath)) {
        return [];
    }

    $config = json_decode((string) file_get_contents($phpxJsonPath), true);
    if (!is_array($config)) {
        phpxFail("invalid JSON in {$phpxJsonPath}");
    }

    $dependencies = $config['dependencies'] ?? [];
    if (!is_array($dependencies)) {
        phpxFail("'dependencies' in {$phpxJsonPath} must be an object");
    }

    return $dependencies;
}

function cmdRun(string $device): void
{
    $projectDir = getcwd();
    $homePagePath = $projectDir . '/app/HomePage.php';
    $flutterDir = $projectDir . '/.flutter';

    if (!is_file($homePagePath)) {
        phpxFail("no app/HomePage.php found in {$projectDir}");
    }

    $dependencies = readDependencies($projectDir);
    (new PubspecDependencyWriter())->write($dependencies, $flutterDir . '/pubspec.yaml');
    if ($dependencies !== []) {
        echo 'Synced ' . count($dependencies) . " dependencies into pubspec.yaml\n";
    }

    $statements = (new Parser())->parseFile($homePagePath);
    $screen = (new ScreenExtractor())->extract($statements);

    $stateFieldNames = array_map(static fn ($field) => $field->name, $screen->stateFields);
    $emitter = new DartEmitter($stateFieldNames);

    $stateFields = array_map(static fn ($field) => [
        'name' => $field->name,
        'dartType' => $field->dartType,
        'defaultDart' => $emitter->emit($field->default),
    ], $screen->stateFields);

    $buildBodyDart = $emitter->emit($screen->buildReturnExpr);

    (new FlutterProjectGenerator())->generate($screen, $stateFields, $buildBodyDart, $flutterDir);

    echo "Generated {$flutterDir}/lib/main.dart\n";

    chdir($flutterDir);
    passthruOrFail('flutter pub get');
    passthruOrFail('flutter run -d ' . escapeshellarg($device));
}

$command = $argv[1] ?? null;

switch ($command) {
    case 'create':
        cmdCreate($argv[2] ?? phpxFail('usage: phpx create <name>'));
        break;
    case 'run':
        cmdRun($argv[2] ?? phpxFail('usage: phpx run <device>'));
        break;
    default:
        phpxFail('usage: phpx <create|run> ...');
}
