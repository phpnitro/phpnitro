{
    "require": {
        "php": ">=8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/yaml": "^8.1",
        "doctrine/dbal": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Engine\\": "packages/ui/src/",
            "Engine\\Database\\": "packages/database/src/",
            "Engine\\App\\": "lib/pages/app/",
            "Backend\\": "lib/backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Engine\\Tests\\": "packages/ui/tests/",
            "Engine\\Database\\Tests\\": "packages/database/tests/"
        }
    }
}
