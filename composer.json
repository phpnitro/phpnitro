{
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/yaml": "^8.1",
        "doctrine/dbal": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Engine\\": "packages/ui/src/",
            "Engine\\Database\\": "packages/database/src/",
            "Engine\\Payments\\": "packages/payments/src/",
            "Engine\\Maps\\": "packages/maps/src/",
            "Engine\\Dialogs\\": "packages/dialogs/src/",
            "Engine\\Firebase\\": "packages/firebase/src/",
            "Engine\\Device\\": "packages/device/src/",
            "Engine\\Countries\\": "packages/countries/src/",
            "Engine\\Preferences\\": "packages/preferences/src/",
            "Engine\\Connectivity\\": "packages/connectivity/src/",
            "Engine\\App\\": "lib/pages/app/",
            "Backend\\": "lib/backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Engine\\Tests\\": "packages/ui/tests/",
            "Engine\\Database\\Tests\\": "packages/database/tests/",
            "Engine\\Payments\\Tests\\": "packages/payments/tests/",
            "Engine\\Maps\\Tests\\": "packages/maps/tests/",
            "Engine\\Dialogs\\Tests\\": "packages/dialogs/tests/",
            "Engine\\Firebase\\Tests\\": "packages/firebase/tests/",
            "Engine\\Device\\Tests\\": "packages/device/tests/",
            "Engine\\Countries\\Tests\\": "packages/countries/tests/",
            "Engine\\Preferences\\Tests\\": "packages/preferences/tests/",
            "Engine\\Connectivity\\Tests\\": "packages/connectivity/tests/",
            "Engine\\Payments\\Tests\\": "packages/payments/tests/"
        }
    }
}
