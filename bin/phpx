#!/usr/bin/env php
<?php

/**
 * phpx — CLI for PhpNitro, the PHP mobile framework.
 *
 * Commands:
 *   phpx make:page <Name>              Generate a Page + a paired backend Controller (auto-discovered, no route to register)
 *   phpx make:auth                    Scaffold Login/Register/ForgotPassword/ResetPassword + paired Controllers
 *   phpx make:entity <Name>           Generate an Entity + a paired Repository
 *   phpx make:migration <name>        Generate a timestamped database migration
 *   phpx migrate                      Apply pending migrations
 *   phpx migrate:rollback             Roll back the last batch of migrations
 *   phpx migrate:status               List applied/pending migrations
 *   phpx serve [port]                 Serve public/ (defaults to 8090)
 *   phpx new <directory> [--all]      Scaffold a new project: android/ ios/ lib/ public/ assets/ (+linux/macos/windows with --all)
 *   phpx bundle:android               Copy public/ + lib/ + packages/ + .env into the Android app
 *   phpx build:android [debug|release] Bundle + gradle assemble, auto-installing Gradle if needed
 *   phpx dev:push [--watch]           Push PHP straight to a connected device's running app, no rebuild/reinstall
 *   phpx payments                     List phpnitro.yml's declared payment gateways and their .env status
 *   phpx maps                         List phpnitro.yml's declared map providers and their .env status
 *   phpx icon                         Regenerate the Android launcher icon from phpnitro.yml's `icon`
 *   phpx firebase                     List phpnitro.yml's declared Firebase config and their .env status
 *   phpx docs:api                     Generate docs/api/*.md from every public class's docblocks + signatures
 *   phpx doctor                       Check the local machine's readiness for phpx development
 *
 * phpnitro.yml (project root) is the app manifest — name/description/version,
 * the payment gateways and map providers the app declares, and optionally
 * `icon`/`icon_background` for the Android launcher icon. `serve` keeps
 * .env's APP_NAME in sync with `name`; `bundle:android` additionally syncs
 * the native app label (strings.xml) and regenerates the launcher icon.
 */

// PHPX_TOOL_ROOT is where this script itself lives — used only by cmdNew()
// to locate the framework's own checkout as the template it scaffolds a new
// project from. PHPX_ROOT is the project phpx operates ON, and is always the
// caller's current directory (like `composer`/`artisan`/`flutter`): every
// other command assumes you've `cd`ed into the project first, so a phpx
// installed once globally (symlinked into PATH, or a phpx.phar) works
// against whichever project you're standing in, not wherever phpx itself
// happens to be installed.
define('PHPX_TOOL_ROOT', dirname(__DIR__));
define('PHPX_ROOT', getcwd());

// Not project-relative — phpx itself ships this, independent of whatever
// a project's own composer.json/vendor happens to declare (see cmdServe()'s
// QR code for PhpNitro Go).
require_once __DIR__ . '/QrCode.php';

// The github.com/phpnitro/android-engine tag a scaffolded project's
// android/app/build.gradle.kts pins via JitPack — bump alongside a real
// android/engine/ release (see this monorepo's own android/engine/ for
// the source that tag mirrors).
define('ANDROID_ENGINE_VERSION', 'v1.2.0');

/**
 * The bare "PHPNITRO" wordmark every letter needed for this specific
 * word — not a general figlet/toilet port (those are whole external
 * binaries with full alphabets/fonts, real dependencies this framework
 * has otherwise avoided reaching for all along, e.g. QrCode::toTerminal()
 * hand-rolls its own QR rendering rather than shelling out to `qrencode`).
 * Each letter is a 5-row x 5-col block glyph; buildBanner() joins them
 * with a 1-column gap and does the '#'/'.' -> block/space substitution
 * ONCE, programmatically — a hand-typed final string is exactly the kind
 * of thing that silently goes one column ragged on one row and nobody
 * notices until it's already merged (caught for real while building
 * this: a hand-typed version came out 51/52/52/52/51 columns instead of
 * a consistent 47).
 *
 * @return array<int, string>
 */
function phpxBannerLines(): array
{
    $letters = [
        'P' => ['####.', '#...#', '####.', '#....', '#....'],
        'H' => ['#...#', '#...#', '#####', '#...#', '#...#'],
        'N' => ['#...#', '##..#', '#.#.#', '#..##', '#...#'],
        'I' => ['#####', '..#..', '..#..', '..#..', '#####'],
        'T' => ['#####', '..#..', '..#..', '..#..', '..#..'],
        'R' => ['####.', '#...#', '####.', '#..#.', '#...#'],
        'O' => ['.###.', '#...#', '#...#', '#...#', '.###.'],
    ];

    $word = str_split('PHPNITRO');
    $lines = [];
    for ($row = 0; $row < 5; $row++) {
        $glyphs = array_map(static fn (string $letter): string => $letters[$letter][$row], $word);
        $lines[] = str_replace(['#', '.'], ['█', ' '], implode(' ', $glyphs));
    }

    return $lines;
}

function printPhpxUsage(): void
{
    $isTty = function_exists('posix_isatty') && posix_isatty(STDOUT);
    $cyan = $isTty ? "\033[36m" : '';
    $reset = $isTty ? "\033[0m" : '';
    $bold = $isTty ? "\033[1m" : '';

    foreach (phpxBannerLines() as $line) {
        echo "{$cyan}{$line}{$reset}\n";
    }
    echo "\n{$bold}Le framework PHP pour de vraies apps Android natives — pas de WebView.{$reset}\n\n";

    $commands = [
        'make:page <Name>' => 'Génère une Page + un Controller backend associé',
        'make:auth' => 'Scaffold Login/Register/ForgotPassword/ResetPassword + Controllers associés',
        'make:entity <Name>' => 'Génère une Entity + un Repository associé',
        'make:migration <name>' => 'Génère une migration de base de données',
        'migrate' => 'Applique les migrations en attente',
        'migrate:rollback' => 'Annule le dernier lot de migrations',
        'migrate:status' => 'Liste les migrations appliquées/en attente',
        'serve [port]' => 'Sert public/ (8090 par défaut)',
        'new <directory> [--all]' => 'Crée un nouveau projet (android/ ios/ par défaut, +linux/ macos/ windows/ avec --all)',
        'bundle:android' => "Copie public/ + lib/ + packages/ + .env dans l'app Android",
        'build:android [debug|release]' => 'bundle:android + gradle assemble (installe Gradle si besoin)',
        'dev:push [--watch]' => "Pousse le PHP directement sur un device connecté, sans rebuild",
        'payments' => 'Liste les moyens de paiement déclarés dans phpnitro.yml',
        'maps' => 'Liste les fournisseurs de carte déclarés dans phpnitro.yml',
        'icon' => "Régénère l'icône Android depuis phpnitro.yml",
        'firebase' => 'Liste la config Firebase déclarée dans phpnitro.yml',
        'docs:api' => 'Génère docs/api/*.md depuis les docblocks des classes publiques',
        'doctor' => 'Vérifie que la machine est prête pour développer avec phpx',
    ];

    $width = max(array_map('strlen', array_keys($commands)));
    foreach ($commands as $usage => $description) {
        $padded = str_pad($usage, $width);
        echo "  {$cyan}phpx {$padded}{$reset}  {$description}\n";
    }
    echo "\n";
}

function phpxFail(string $message): never
{
    fwrite(STDERR, "phpx: {$message}\n");
    exit(1);
}

function passthruOrFail(string $command): void
{
    passthru($command, $exitCode);
    if ($exitCode !== 0) {
        phpxFail("command failed ({$exitCode}): {$command}");
    }
}

function pageClassName(string $name): string
{
    $className = str_replace([' ', '-', '_'], '', ucwords(preg_replace('/[\s\-_]+/', ' ', $name)));

    return str_ends_with($className, 'Page') ? $className : $className . 'Page';
}

function controllerClassNameFor(string $pageClassName): string
{
    return preg_replace('/Page$/', '', $pageClassName) . 'Controller';
}

function pageTemplate(string $className): string
{
    return <<<PHP
    <?php

    namespace Engine\App;

    use Engine\Native\Scaffold;
    use Engine\Native\Center;
    use Engine\Native\Widget;
    use Engine\Native\Text;
    use Engine\Native\Tokens;

    final class {$className}
    {
        public static function build(float \$screenWidth, float \$screenHeight): Widget
        {
            return new Scaffold(
                new Center(new Text('{$className}', Tokens::TEXT_TITLE, Tokens::ink()->toHex(), bold: true)),
                \$screenWidth,
                \$screenHeight,
            );
        }
    }

    PHP;
}

function controllerTemplate(string $className): string
{
    return <<<PHP
    <?php

    namespace Backend\Controller;

    use Symfony\Component\HttpFoundation\JsonResponse;
    use Symfony\Component\HttpFoundation\Request;
    use Symfony\Component\HttpFoundation\Response;

    final class {$className}
    {
        public function handle(Request \$request): Response
        {
            return new JsonResponse(['message' => 'OK']);
        }
    }

    PHP;
}

/**
 * Just creates the files — nothing to wire up. Both /native/layout-demo
 * (via minimalLayoutDemoRoute()) and Kernel::handle() (via
 * minimalKernelTemplate()) discover pages/controllers straight from
 * lib/pages/ and lib/backend/src/Controller/ at request time
 * (Engine\AutoRouter::discover()), keyed by class name convention — the
 * same file-presence-is-the-route-table model Next.js's pages/ directory
 * or Flutter's generated go_router routes use, instead of a table this
 * command would otherwise have to keep in sync by editing generated files.
 */
function cmdMakePage(string $name): void
{
    require_once PHPX_ROOT . '/vendor/autoload.php';

    $className = pageClassName($name);
    $pagePath = PHPX_ROOT . "/lib/pages/{$className}.php";
    $controllerClassName = controllerClassNameFor($className);
    $controllerPath = PHPX_ROOT . "/lib/backend/src/Controller/{$controllerClassName}.php";

    if (is_file($pagePath)) {
        phpxFail("page already exists: {$pagePath}");
    }
    if (is_file($controllerPath)) {
        phpxFail("controller already exists: {$controllerPath}");
    }

    $screenKey = \Engine\AutoRouter::routeKey($className, ['Page', 'Screen']);
    $apiKey = \Engine\AutoRouter::routeKey($controllerClassName, ['Controller']);

    file_put_contents($pagePath, pageTemplate($className));
    echo "Created {$pagePath} (reachable at ?screen={$screenKey})\n";

    file_put_contents($controllerPath, controllerTemplate($controllerClassName));
    echo "Created {$controllerPath} (reachable at /api" . ($apiKey === 'home' ? '' : "/{$apiKey}") . ")\n";
}

function entityClassName(string $name): string
{
    return str_replace([' ', '-', '_'], '', ucwords(preg_replace('/[\s\-_]+/', ' ', $name)));
}

function tableNameFor(string $className): string
{
    return strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $className));
}

function entityTemplate(string $className): string
{
    return <<<PHP
    <?php

    namespace Backend\Entity;

    final class {$className}
    {
        public function __construct(
            public readonly ?int \$id = null,
        ) {
        }
    }

    PHP;
}

function repositoryTemplate(string $className, string $table): string
{
    return <<<PHP
    <?php

    namespace Backend\Repository;

    use Backend\Entity\\{$className};
    use Engine\Database\Database;

    final class {$className}Repository
    {
        public function __construct()
        {
            \$this->ensureSchema();
        }

        private function ensureSchema(): void
        {
            Database::connection()->executeStatement(
                'CREATE TABLE IF NOT EXISTS {$table} (id INTEGER PRIMARY KEY AUTOINCREMENT)',
            );
        }

        public function find(int \$id): ?{$className}
        {
            \$row = Database::connection()->fetchAssociative('SELECT * FROM {$table} WHERE id = ?', [\$id]);

            return \$row === false ? null : new {$className}(id: (int) \$row['id']);
        }

        public function save({$className} \$entity): void
        {
            // Upsert: calling save() twice with the same id must not crash on
            // a duplicate primary key — add your own fields to both branches
            // below as you grow this entity past just "id".
            \$exists = \$entity->id !== null && \$this->find(\$entity->id) !== null;

            if (\$exists) {
                Database::connection()->update('{$table}', ['id' => \$entity->id], ['id' => \$entity->id]);
            } else {
                Database::connection()->insert('{$table}', ['id' => \$entity->id]);
            }
        }
    }

    PHP;
}

function cmdMakeEntity(string $name): void
{
    $className = entityClassName($name);
    $entityPath = PHPX_ROOT . "/lib/backend/src/Entity/{$className}.php";
    $repositoryPath = PHPX_ROOT . "/lib/backend/src/Repository/{$className}Repository.php";

    if (is_file($entityPath)) {
        phpxFail("entity already exists: {$entityPath}");
    }
    if (is_file($repositoryPath)) {
        phpxFail("repository already exists: {$repositoryPath}");
    }

    $table = tableNameFor($className);

    file_put_contents($entityPath, entityTemplate($className));
    echo "Created {$entityPath}\n";

    file_put_contents($repositoryPath, repositoryTemplate($className, $table));
    echo "Created {$repositoryPath}\n";
}

/**
 * Login/Register/ForgotPassword/ResetPassword + their two repositories —
 * copied straight from THIS framework's own lib/ (PHPX_TOOL_ROOT), not
 * re-templated here, so there's exactly one implementation to maintain:
 * the real, working, curl-verified one this monorepo's own demo already
 * uses (see public/index.php's "google_signin"/"oauth_callback:"/
 * "register"/"forgot_password"/"reset_password" action handling for the
 * exact reference). Same "create files, print where they're reachable,
 * let the developer wire the one match($screen) line themselves" scope
 * as cmdMakePage() — deliberately NOT attempting to auto-edit an unknown
 * project's own public/index.php; a single bad anchor match there would
 * silently corrupt a file this command has no business rewriting
 * unattended.
 */
function cmdMakeAuth(): void
{
    require_once PHPX_ROOT . '/vendor/autoload.php';

    $pages = ['NativeLoginScreen', 'NativeRegisterScreen', 'NativeForgotPasswordScreen', 'NativeResetPasswordScreen'];
    $repositories = ['UserRepository', 'PasswordResetRepository'];
    $created = [];

    foreach ($pages as $name) {
        $created[] = copyTemplateFile("lib/pages/{$name}.php");
    }
    foreach ($repositories as $name) {
        $created[] = copyTemplateFile("lib/backend/src/Repository/{$name}.php");
    }

    echo "\n";
    echo "Ajoute ces routes à public/index.php (dans le \$tree = match (\$screen) { ... }) :\n";
    echo "    'login' => \\Engine\\App\\NativeLoginScreen::build(\$screenWidth, \$loginError),\n";
    echo "    'register' => \\Engine\\App\\NativeRegisterScreen::build(\$screenWidth, \$registerError),\n";
    echo "    'forgot-password' => \\Engine\\App\\NativeForgotPasswordScreen::build(\$screenWidth, \$forgotPasswordError, \$devResetLink),\n";
    echo "    'reset-password' => \\Engine\\App\\NativeResetPasswordScreen::build(\$screenWidth, \$resetPasswordError, \$resetPasswordSuccess),\n";
    echo "\n";
    echo "Et la logique de traitement des actions (login/register/forgot_password/reset_password,\n";
    echo "vérification password_hash(), génération/validation des tokens de réinitialisation) —\n";
    echo "copie-la depuis public/index.php de ce framework (chercher \"NativeRegisterScreen's counterpart\"\n";
    echo "et les blocs qui suivent) : " . PHPX_TOOL_ROOT . "/public/index.php\n";
    echo "\n";
    echo "Pour Google/GitHub/Facebook/Microsoft/Apple (connexion sociale) :\n";
    echo "  composer require phpnitro/socialauth\n";
    echo "  Voir docs/tutorials/authentification-sociale.md et NativeWidgetsFirebaseAuthScreen.php\n";
    echo "  (même framework) pour l'exemple complet — Google a besoin d'un Web Client ID\n";
    echo "  (res/values/strings.xml -> google_web_client_id), les autres d'un client_id/secret\n";
    echo "  OAuth dans .env (GITHUB_CLIENT_ID, FACEBOOK_CLIENT_ID, etc.).\n";
}

/**
 * Same shape as cmdMakeMigration()'s generated stub expects: a single
 * `return new class extends Migration {...}` per file, so make:migration/
 * migrate/rollback/status never have to derive a class name from a
 * filename — the file already IS the migration.
 */
function migrationClassNameStub(): string
{
    return <<<'PHP'
    <?php

    use Doctrine\DBAL\Connection;
    use Engine\Database\Migration;

    return new class extends Migration {
        public function up(Connection $connection): void
        {
            // $connection->executeStatement('CREATE TABLE posts (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT)');
        }

        public function down(Connection $connection): void
        {
            // $connection->executeStatement('DROP TABLE posts');
        }
    };

    PHP;
}

function cmdMakeMigration(string $name): void
{
    $migrationsDir = PHPX_ROOT . '/lib/backend/migrations';
    if (!is_dir($migrationsDir)) {
        mkdir($migrationsDir, 0777, true);
    }

    $snake = strtolower((string) preg_replace('/[^A-Za-z0-9]+/', '_', $name));
    $snake = trim($snake, '_');
    if ($snake === '') {
        phpxFail('usage: phpx make:migration <name> (ex. create_posts_table)');
    }

    // A timestamp prefix, not an incrementing counter — Migrator::
    // allMigrationFiles() sorts by filename to decide run order, and a
    // timestamp survives two developers each running make:migration on
    // their own branch without colliding (an incrementing counter
    // shared through git would).
    $filename = date('YmdHis') . "_{$snake}.php";
    $path = "{$migrationsDir}/{$filename}";

    if (is_file($path)) {
        phpxFail("already exists: {$path}");
    }

    file_put_contents($path, migrationClassNameStub());
    echo "Created lib/backend/migrations/{$filename}\n";
}

/**
 * Same bootstrap public/index.php's own top does (Dotenv + Database::
 * useSqlitePath()) — this is a CLI entry point into the same project's
 * database, not a separate one, so it has to resolve the connection the
 * exact same way a real request would or `phpx migrate` could silently
 * migrate a different database than the one the running app actually
 * reads from.
 */
function bootstrapProjectDatabase(): void
{
    $autoload = PHPX_ROOT . '/vendor/autoload.php';
    if (!is_file($autoload)) {
        phpxFail('vendor/autoload.php introuvable — lancez cette commande depuis la racine d\'un projet PhpNitro (composer install déjà fait).');
    }
    require_once $autoload;

    foreach ([PHPX_ROOT . '/.env', PHPX_ROOT . '/env'] as $envFile) {
        if (is_file($envFile)) {
            (new \Symfony\Component\Dotenv\Dotenv())->loadEnv($envFile);
            break;
        }
    }

    if (!class_exists(\Engine\Database\Database::class)) {
        phpxFail('phpnitro/database n\'est pas installé — composer require phpnitro/database.');
    }
    \Engine\Database\Database::useSqlitePath(PHPX_ROOT . '/lib/backend/var/data.sqlite');
}

function newMigrator(): \Engine\Database\Migrator
{
    bootstrapProjectDatabase();

    return new \Engine\Database\Migrator(\Engine\Database\Database::connection(), PHPX_ROOT . '/lib/backend/migrations');
}

function cmdMigrate(): void
{
    $ran = newMigrator()->migrate();

    if ($ran === []) {
        echo "Rien à migrer — déjà à jour.\n";
        return;
    }
    foreach ($ran as $migration) {
        echo "Migré : {$migration}\n";
    }
}

function cmdMigrateRollback(): void
{
    $rolledBack = newMigrator()->rollback();

    if ($rolledBack === []) {
        echo "Rien à annuler.\n";
        return;
    }
    foreach ($rolledBack as $migration) {
        echo "Annulé : {$migration}\n";
    }
}

function cmdMigrateStatus(): void
{
    $status = newMigrator()->status();

    if ($status === []) {
        echo "Aucune migration dans lib/backend/migrations/ — voir `phpx make:migration`.\n";
        return;
    }
    foreach ($status as $entry) {
        echo ($entry['ran'] ? '  [✓] ' : '  [ ] ') . $entry['migration'] . "\n";
    }
}

/**
 * @return string the destination path (for cmdMakeAuth()'s own summary — currently unused but kept for future callers)
 */
function copyTemplateFile(string $relativePath): string
{
    $source = PHPX_TOOL_ROOT . '/' . $relativePath;
    $destination = PHPX_ROOT . '/' . $relativePath;

    if (!is_file($source)) {
        phpxFail("template missing: {$source} — this phpx installation looks incomplete or out of date");
    }
    if (is_file($destination)) {
        echo "Skipped {$destination} (already exists)\n";

        return $destination;
    }

    @mkdir(dirname($destination), 0777, true);
    copy($source, $destination);
    echo "Created {$destination}\n";

    return $destination;
}

/**
 * Copies assets/ (images, fonts, the framework's own JS under assets/js/)
 * into public/assets/ so both the dev server and the Android bundle serve it
 * the exact same way (a plain static file next to tailwind.css — no
 * special-casing in the router).
 */
function syncAssets(): void
{
    $source = PHPX_ROOT . '/assets';
    $destination = PHPX_ROOT . '/public/assets';

    if (is_dir($destination)) {
        passthruOrFail('rm -rf ' . escapeshellarg($destination));
    }

    copyDirectory($source, $destination, ['README.md']);
}

/**
 * @return array<string, mixed>
 */
function loadManifest(): array
{
    $manifestPath = PHPX_ROOT . '/phpnitro.yml';
    if (!is_file($manifestPath)) {
        return [];
    }

    require_once PHPX_ROOT . '/vendor/autoload.php';

    return \Symfony\Component\Yaml\Yaml::parseFile($manifestPath) ?? [];
}

/**
 * phpnitro.yml's `name` is the single source of truth for the app's display
 * name — this keeps .env's APP_NAME in sync instead of two places to edit
 * whenever the app gets renamed. No-op for projects without a manifest.
 */
function syncManifestToEnv(): void
{
    $manifest = loadManifest();
    if (!isset($manifest['name'])) {
        return;
    }

    $envPath = PHPX_ROOT . '/.env';
    $env = is_file($envPath) ? file_get_contents($envPath) : '';
    $line = 'APP_NAME="' . addslashes($manifest['name']) . '"';

    $env = preg_match('/^APP_NAME=.*$/m', $env)
        ? preg_replace('/^APP_NAME=.*$/m', $line, $env)
        : rtrim($env) . "\n" . $line . "\n";

    file_put_contents($envPath, $env);
}

/**
 * Rewrites android/.../res/values/strings.xml's app_name from the
 * manifest's `name` — the OS-level launcher label, distinct from .env's
 * APP_NAME (read at runtime by the PHP app itself). Only meaningful for
 * the packaged APK, so this only runs from cmdBundleAndroid(), not serve().
 */
function syncManifestToAndroidStrings(string $androidResDir): void
{
    $manifest = loadManifest();
    if (!isset($manifest['name'])) {
        return;
    }

    $stringsPath = "{$androidResDir}/values/strings.xml";
    if (!is_file($stringsPath)) {
        return;
    }

    $escaped = htmlspecialchars($manifest['name'], ENT_XML1 | ENT_QUOTES);
    $strings = file_get_contents($stringsPath);
    $strings = preg_replace('#<string name="app_name">.*?</string>#', "<string name=\"app_name\">{$escaped}</string>", $strings);

    file_put_contents($stringsPath, $strings);
}

/**
 * Generates the Android launcher icon (legacy mipmaps + adaptive icon) from
 * the manifest's `icon` (a square PNG path, relative to the project root)
 * and `icon_background` (hex color, defaults to white) — see
 * bin/generate-android-icon.php. No-op if `icon` isn't declared, so
 * projects that haven't opted in keep their existing hand-authored icon.
 */
function syncManifestIcon(string $androidResDir): void
{
    $manifest = loadManifest();
    if (!isset($manifest['icon'])) {
        return;
    }

    $iconPath = PHPX_ROOT . '/' . $manifest['icon'];
    $background = $manifest['icon_background'] ?? '#FFFFFF';
    $generator = __DIR__ . '/generate-android-icon.php';

    passthruOrFail(sprintf(
        'php %s %s %s %s',
        escapeshellarg($generator),
        escapeshellarg($iconPath),
        escapeshellarg($androidResDir),
        escapeshellarg($background),
    ));
}

function cmdPayments(): void
{
    $manifest = loadManifest();
    $payments = $manifest['payments'] ?? [];

    if ($payments === []) {
        echo "Aucun moyen de paiement déclaré dans phpnitro.yml.\n";

        return;
    }

    $envPath = PHPX_ROOT . '/.env';
    if (is_file($envPath)) {
        (new \Symfony\Component\Dotenv\Dotenv())->loadEnv($envPath);
    }

    echo "Moyens de paiement déclarés dans phpnitro.yml :\n\n";

    foreach ($payments as $name => $config) {
        $publicKeyEnv = $config['public_key_env'] ?? null;
        $secretKeyEnv = $config['secret_key_env'] ?? null;

        $publicSet = $publicKeyEnv !== null && ($_ENV[$publicKeyEnv] ?? '') !== '';
        $secretSet = $secretKeyEnv !== null && ($_ENV[$secretKeyEnv] ?? '') !== '';

        $status = match (true) {
            $publicSet && $secretSet => 'configuré (clé publique + secrète)',
            $publicSet => 'clé publique seule — vérification serveur désactivée, mode démo',
            default => 'non configuré',
        };

        printf("  %-14s %s\n", $name, $status);
    }
}

function cmdMaps(): void
{
    $manifest = loadManifest();
    $maps = $manifest['maps'] ?? [];

    $envPath = PHPX_ROOT . '/.env';
    if (is_file($envPath)) {
        (new \Symfony\Component\Dotenv\Dotenv())->loadEnv($envPath);
    }

    echo "Fournisseurs de carte déclarés dans phpnitro.yml :\n\n";

    // Chaque fournisseur n'a qu'une seule clé (access_token_env pour
    // Mapbox, api_key_env pour Google...) contrairement aux gateways de
    // paiement qui ont une paire publique/secrète — prendre la première
    // (et unique) valeur du sous-tableau évite de coder en dur le nom du
    // champ par fournisseur.
    foreach ($maps as $name => $config) {
        $keyEnv = array_values($config)[0] ?? null;
        $configured = $keyEnv !== null && ($_ENV[$keyEnv] ?? '') !== '';

        printf("  %-14s %s\n", $name, $configured ? 'configuré' : 'non configuré');
    }

    printf("  %-14s %s\n", 'openstreetmap', 'toujours disponible (aucune clé requise)');
}

function cmdFirebase(): void
{
    $manifest = loadManifest();
    $firebase = $manifest['firebase'] ?? [];

    if ($firebase === []) {
        echo "Firebase non déclaré dans phpnitro.yml.\n";

        return;
    }

    $envPath = PHPX_ROOT . '/.env';
    if (is_file($envPath)) {
        (new \Symfony\Component\Dotenv\Dotenv())->loadEnv($envPath);
    }

    echo "Firebase (phpnitro.yml) :\n\n";

    // Flat map (label => nom de variable d'environnement), contrairement à
    // payments/maps qui groupent plusieurs fournisseurs — Firebase n'a
    // qu'un seul projet possible ici, donc un seul niveau suffit.
    $labels = [
        'service_account_env' => 'compte de service (FCM + Firestore)',
        'project_id_env' => 'project ID',
        'web_api_key_env' => 'cle API web (Firebase Auth)',
    ];

    foreach ($firebase as $key => $envVarName) {
        $configured = ($_ENV[$envVarName] ?? '') !== '';
        $label = $labels[$key] ?? $key;

        printf("  %-32s %s\n", $label, $configured ? 'configuré' : 'non configuré');
    }
}

/**
 * Reflects over every public class reachable from composer.json's own
 * autoload map (skipping Engine\App\/Backend\, which are app-specific, not
 * "the framework's API") and writes one docs/api/{package}.md per
 * packages/*\/src directory, plus an docs/api.md index — a docblock- and
 * signature-derived reference, not hand-written, so it can't silently
 * drift the way hand-maintained API docs do.
 */
function cmdGenerateApiDocs(): void
{
    require_once PHPX_ROOT . '/vendor/autoload.php';

    $composer = json_decode((string) file_get_contents(PHPX_ROOT . '/composer.json'), true, flags: JSON_THROW_ON_ERROR);
    $namespaces = $composer['autoload']['psr-4'] ?? [];

    $apiDir = PHPX_ROOT . '/docs/api';
    foreach (glob("{$apiDir}/*.md") ?: [] as $stale) {
        unlink($stale);
    }
    if (!is_dir($apiDir)) {
        mkdir($apiDir, 0777, true);
    }

    $packages = [];

    foreach ($namespaces as $prefix => $relativeDir) {
        if (in_array($prefix, ['Engine\\App\\', 'Backend\\'], true)) {
            continue;
        }

        $dir = PHPX_ROOT . '/' . rtrim($relativeDir, '/');
        if (!is_dir($dir)) {
            continue;
        }

        $packageName = basename(dirname($relativeDir));
        $packages[$packageName] ??= [];

        // Recursive, not glob("{$dir}/*.php") — that only ever saw files
        // directly in $dir, silently skipping every class in a
        // sub-namespace's own subdirectory (PSR-4: a subdirectory IS a
        // sub-namespace). packages/ui/src/ maps to the bare "Engine\\"
        // prefix, but every real widget (Button, Canvas, Container...)
        // lives under packages/ui/src/Native/ — Engine\Native\* — which
        // this missed entirely until now: 1 class documented out of
        // ~100+, confirmed by re-running this after the fix.
        foreach (globPhpFilesRecursive($dir) as $file) {
            $relativePath = ltrim(substr($file, strlen($dir)), '/');
            $classSuffix = str_replace('/', '\\', substr($relativePath, 0, -4));
            $className = $prefix . $classSuffix;
            if (class_exists($className) || interface_exists($className) || enum_exists($className)) {
                $packages[$packageName][] = $className;
            }
        }
    }

    ksort($packages);
    $index = ["# Référence API\n", "Générée automatiquement (`phpx docs:api`) depuis les docblocks et signatures réels — jamais à éditer à la main, elle serait écrasée au prochain run.\n"];

    $totalClasses = 0;
    foreach ($packages as $packageName => $classNames) {
        sort($classNames);
        $totalClasses += count($classNames);
        $classCount = count($classNames);
        $index[] = "- [{$packageName}](api/{$packageName}.md) ({$classCount} " . ($classCount > 1 ? 'classes' : 'classe') . ')';

        $page = ["# Package `{$packageName}`\n"];
        foreach ($classNames as $className) {
            $page[] = renderClassApiDoc($className);
        }

        file_put_contents("{$apiDir}/{$packageName}.md", implode("\n", $page));
    }

    file_put_contents(PHPX_ROOT . '/docs/api.md', implode("\n", $index) . "\n");

    echo "Generated API reference for {$totalClasses} classes across " . count($packages) . " packages into docs/api/\n";
}

/** @return string[] absolute paths, every *.php file under $dir at any depth. */
function globPhpFilesRecursive(string $dir): array
{
    $result = [];
    foreach (glob("{$dir}/*") ?: [] as $entry) {
        if (is_dir($entry)) {
            $result = array_merge($result, globPhpFilesRecursive($entry));
        } elseif (str_ends_with($entry, '.php')) {
            $result[] = $entry;
        }
    }

    return $result;
}

function renderClassApiDoc(string $className): string
{
    $reflection = new ReflectionClass($className);
    $kind = match (true) {
        $reflection->isInterface() => 'interface',
        $reflection->isEnum() => 'enum',
        default => 'class',
    };

    $lines = ["## `{$className}` ({$kind})\n"];
    $summary = docCommentSummary($reflection->getDocComment());
    if ($summary !== '') {
        $lines[] = "{$summary}\n";
    }

    foreach ($reflection->getMethods(ReflectionMethod::IS_PUBLIC) as $method) {
        // Only this class's own methods — an inherited method belongs on
        // its declaring class's page, listing it here too would just be
        // noise repeated on every subclass.
        if ($method->getDeclaringClass()->getName() !== $className) {
            continue;
        }
        if (str_starts_with($method->getName(), '__') && $method->getName() !== '__construct') {
            continue;
        }

        $lines[] = '### `' . renderMethodSignature($method) . "`\n";
        $methodSummary = docCommentSummary($method->getDocComment());
        if ($methodSummary !== '') {
            $lines[] = "{$methodSummary}\n";
        }
    }

    return implode("\n", $lines);
}

function renderMethodSignature(ReflectionMethod $method): string
{
    $params = array_map(static function (ReflectionParameter $param): string {
        $type = $param->hasType() ? $param->getType() . ' ' : '';
        $default = '';
        if ($param->isDefaultValueAvailable()) {
            try {
                $default = ' = ' . var_export($param->getDefaultValue(), true);
            } catch (\Throwable) {
                $default = ' = ...';
            }
        }

        return "{$type}\${$param->getName()}{$default}";
    }, $method->getParameters());

    $returnType = $method->hasReturnType() ? ': ' . $method->getReturnType() : '';
    $static = $method->isStatic() ? 'static ' : '';

    return "{$static}{$method->getName()}(" . implode(', ', $params) . "){$returnType}";
}

/**
 * First paragraph of a docblock, tags stripped, comment markers stripped,
 * wrapped onto one line — a summary line for an index/method list, not the
 * full docblock (which usually explains design rationale a one-line
 * reference table has no room for).
 */
function docCommentSummary(string|false $docComment): string
{
    if ($docComment === false) {
        return '';
    }

    $summary = [];
    foreach (preg_split('/\r?\n/', $docComment) ?: [] as $line) {
        $line = trim($line, " \t*/");
        if ($line === '' && $summary !== []) {
            break;
        }
        if ($line === '' || str_starts_with($line, '@')) {
            continue;
        }
        $summary[] = $line;
    }

    return implode(' ', $summary);
}

function cmdIcon(): void
{
    $manifest = loadManifest();
    if (!isset($manifest['icon'])) {
        phpxFail("phpnitro.yml ne déclare pas d'icône — ajoute `icon: chemin/vers/icone.png` (carré) pour en générer une.");
    }

    syncManifestIcon(PHPX_ROOT . '/android/app/src/main/res');
}

/**
 * Best-effort LAN IP for the "connect from PhpNitro Go" message below — no
 * data actually leaves the machine, connecting a UDP socket just makes the
 * OS pick which local interface/address would be used to reach that
 * address, which is the standard cross-platform trick for this (no
 * dependency on `hostname -I`/`ip addr`, which aren't available/consistent
 * everywhere). Returns null (silently) rather than failing `phpx serve`
 * over a purely informational message.
 */
function detectLanIp(): ?string
{
    // ext-sockets isn't guaranteed to be compiled into every PHP build —
    // this is a purely informational nicety, not something `phpx serve`
    // should ever fail over.
    if (!function_exists('socket_create')) {
        return null;
    }
    $socket = @socket_create(AF_INET, SOCK_DGRAM, SOL_UDP);
    if ($socket === false) {
        return null;
    }
    if (!@socket_connect($socket, '8.8.8.8', 53)) {
        socket_close($socket);
        return null;
    }
    socket_getsockname($socket, $address);
    socket_close($socket);

    return $address ?: null;
}

function cmdServe(int $port): void
{
    syncAssets();
    syncManifestToEnv();

    $publicDir = PHPX_ROOT . '/public';
    if (!is_dir($publicDir)) {
        phpxFail("no public/ directory found at {$publicDir}");
    }

    // 0.0.0.0, not 127.0.0.1: this is what lets PhpNitro Go (a companion
    // app with no bundled project code, see android/go/) reach this dev
    // server from another device on the same network — the same trade-off
    // `expo start` makes. Real implication, not just theoretical: while
    // `phpx serve` runs, ANYONE on the same Wi-Fi/LAN can reach this
    // server, not just this machine. Fine on a trusted home/office
    // network, not something to run on a public one.
    $lanIp = detectLanIp();
    if ($lanIp !== null) {
        $url = "http://{$lanIp}:{$port}";
        echo "Depuis PhpNitro Go (même réseau) : {$url}\n";
        echo QrCode::toTerminal($url) . "\n";

        // The terminal render above only scans reliably in terminals with
        // perfectly square, gap-free glyph metrics — not a safe assumption.
        // A PNG opened in a browser has no such font-rendering variable, so
        // it's offered as the reliable fallback (same http://LANIP:PORT
        // built-in server serves it directly, no route needed — the PHP
        // dev server serves any file that exists under the docroot as-is).
        QrCode::toPngFile($url, $publicDir . '/__qr.png');
        echo "QR code plus net (si le scan ci-dessus échoue) : {$url}/__qr.png\n";
    }

    passthruOrFail(
        "php -S 0.0.0.0:{$port} -t " . escapeshellarg($publicDir) . ' ' . escapeshellarg($publicDir . '/router.php'),
    );
}

function cmdNew(string $directory, bool $all = false): void
{
    // Resolved against the current working directory (like `composer create-project`
    // or `flutter create`) — a new project lives wherever the developer is
    // working, not nested inside this framework's own checkout.
    $targetDir = str_starts_with($directory, '/') ? $directory : getcwd() . '/' . $directory;

    if (is_dir($targetDir)) {
        phpxFail("directory already exists: {$targetDir}");
    }

    mkdir($targetDir, 0777, true);

    // `packages/` is NOT copied — phpnitro/ui, phpnitro/database,
    // phpnitro/firebase, phpnitro/countries, phpnitro/preferences, and
    // phpnitro/format are real Packagist packages now (mirrored read-only
    // from this monorepo's own packages/*), declared as ordinary
    // composer.json dependencies below and resolved into vendor/ like any
    // other library — the same relationship a Flutter project has with
    // the Flutter SDK: referenced, not copied. `bin/` isn't copied either
    // — phpx is meant to be installed once, globally (see this file's own
    // top-of-file docblock), and every internal `__DIR__`-relative lookup
    // (generate-android-icon.php, etc.) already assumes exactly that.
    // 'assets' in the skip list only ever matches public/assets/ during
    // this loop (there's no "assets" subdirectory INSIDE the top-level
    // assets/ folder itself) — public/assets/ is syncAssets()'s own BUILD
    // OUTPUT (gitignored, mirrors assets/ fresh on every `phpx serve`/
    // `bundle:android` run), so copying it here would leak this
    // monorepo's own dev checkout's currently-synced copy, the same
    // stale-build-artifact mistake already fixed for android/app's
    // assets/www.
    foreach (['lib', 'ios', 'assets', 'public'] as $part) {
        $source = PHPX_TOOL_ROOT . '/' . $part;
        $destination = $targetDir . '/' . $part;
        copyDirectory($source, $destination, [
            'vendor', 'node_modules', '.gradle', 'build', '.kotlin', 'local.properties', 'var', 'assets',
        ]);
        echo "Copied {$part}/ to {$destination}\n";
    }

    // android/ is NOT copied wholesale — android/engine/ is the compiled
    // com.phpnitro:android-engine library (published via JitPack from
    // github.com/phpnitro/android-engine, itself a read-only mirror of
    // this same monorepo's android/engine/), referenced the way a Flutter
    // project references the Flutter SDK, never copied in as source. Only
    // android/app/ (the thin per-app shell: applicationId, res/, deep
    // links, keystore config) plus root-level Gradle config is copied,
    // and that root config is written fresh below rather than copied,
    // since a scaffolded project's settings.gradle.kts/build.gradle.kts
    // differ from this monorepo's own (no `:engine` module to include,
    // JitPack's repository instead of a project() dependency).
    // 'www' excluded deliberately: assets/www is bundle:android's own
    // BUILD OUTPUT (gitignored, regenerated fresh by every bundle:android
    // run) — copying it here would leak whatever this monorepo's own dev
    // checkout happened to have bundled most recently (right down to a
    // stale copy of packages/*/src, the very thing this whole
    // Composer-package migration was meant to stop shipping) into every
    // new project's checkout before it ever ran bundle:android itself.
    copyDirectory(PHPX_TOOL_ROOT . '/android/app', "{$targetDir}/android/app", [
        'vendor', 'node_modules', '.gradle', 'build', '.kotlin', 'local.properties', 'var', 'www',
    ]);
    echo "Copied android/app/ to {$targetDir}/android/app\n";

    // This monorepo's own AndroidManifest.xml is the DEMO app's — it
    // declares every permission the ~30 capability screens exercise
    // (camera, biometrics, location, Bluetooth, contacts, NFC, billing...).
    // A blank project hasn't asked for any of that yet, so it gets a
    // minimal manifest instead of inheriting the demo's permission list —
    // the same reason a fresh `flutter create` ships an empty
    // AndroidManifest.xml, not one with every plugin's permissions
    // pre-declared.
    file_put_contents(
        "{$targetDir}/android/app/src/main/AndroidManifest.xml",
        newProjectAndroidManifestXml(),
    );

    foreach (['keystore.properties.example', 'gradle.properties'] as $file) {
        copy(PHPX_TOOL_ROOT . "/android/{$file}", "{$targetDir}/android/{$file}");
    }
    file_put_contents("{$targetDir}/android/settings.gradle.kts", newProjectAndroidSettingsGradleKts());
    file_put_contents("{$targetDir}/android/build.gradle.kts", newProjectAndroidBuildGradleKts());
    echo "Wrote {$targetDir}/android/{settings,build}.gradle.kts (com.github.phpnitro:android-engine via JitPack)\n";

    $appBuildGradlePath = "{$targetDir}/android/app/build.gradle.kts";
    $appBuildGradle = file_get_contents($appBuildGradlePath);
    if ($appBuildGradle !== false) {
        // Built line-by-line with an explicit 4-space prefix (matching
        // this block's real indentation inside `dependencies { ... }`)
        // rather than a heredoc — a heredoc's closing-marker-driven
        // whitespace stripping silently produced 0-space-indented lines
        // here, which then never matched the file's real 4-space
        // indentation and left the monorepo-specific comment (and the
        // project() dependency) in every scaffolded project untouched.
        $monorepoComment = implode("\n", array_map(static fn (string $line): string => rtrim("    {$line}"), [
            '// The native render engine itself — NativeRenderPocActivity,',
            "// NativeCanvasView, PhpServer, MainActivity's WebView pipeline, every",
            '// Device/*Receiver, libphp.so/libsqlite3.so, and every dependency the',
            "// engine's own code needs (biometric, billing, maps, translate,",
            '// lottie...) come in transitively as `api` dependencies of :engine —',
            '// see android/engine/build.gradle.kts. A project scaffolded via',
            '// `phpx new` instead depends on the published com.phpnitro:engine',
            '// artifact; this project() dependency is this monorepo\'s own',
            '// "developing the framework itself" path.',
            'implementation(project(":engine"))',
        ]));
        $scaffoldedComment = implode("\n", array_map(static fn (string $line): string => rtrim("    {$line}"), [
            '// The native render engine itself — NativeRenderPocActivity,',
            "// NativeCanvasView, PhpServer, MainActivity's WebView pipeline, every",
            '// Device/*Receiver, libphp.so/libsqlite3.so, and every dependency the',
            "// engine's own code needs (biometric, billing, maps, translate,",
            '// lottie...) come in transitively as `api` dependencies of this one',
            '// artifact, published from github.com/phpnitro/android-engine via',
            '// JitPack (see android/settings.gradle.kts\'s repository) — the exact',
            '// relationship a Flutter project has with the Flutter SDK: referenced,',
            '// never copied into your project as source.',
            'implementation("com.github.phpnitro:android-engine:' . ANDROID_ENGINE_VERSION . '")',
        ]));
        file_put_contents($appBuildGradlePath, str_replace($monorepoComment, $scaffoldedComment, $appBuildGradle));
    }

    // --all: the three desktop platforms, opt-in — unlike android/ios
    // (a real production-ready target for most apps), linux/macos/windows
    // are each still pre-alpha (see their own README.md: macOS/Windows have
    // no consuming app yet, only library projects; Linux has a real running
    // app but no PyPI package to reference instead). Wholesale copy, same
    // treatment `ios` already gets above — there's no "reference a
    // published package" option for any of them yet, so copying the actual
    // source is the only way a scaffolded project gets working code at all.
    // Skipped by default so a plain `phpx new` stays exactly what it always
    // was: an Android + iOS project, not a 5-platform one nobody asked for.
    if ($all) {
        foreach (['linux', 'macos', 'windows'] as $part) {
            $source = PHPX_TOOL_ROOT . '/' . $part;
            $destination = $targetDir . '/' . $part;
            copyDirectory($source, $destination, [
                'vendor', 'node_modules', '__pycache__', '.venv',
                'build', 'bin', 'obj', '.build', 'DerivedData',
                '.gradle', '.kotlin', 'local.properties', 'var',
            ]);
            echo "Copied {$part}/ to {$destination}\n";
        }
    }

    // package.json/package-lock.json aren't copied — the only reason a Node
    // toolchain existed here was Tailwind CSS, removed along with the last
    // WebView page (see git history: "remove Tailwind CSS and its JS
    // assets"); copying them used to silently no-op since neither file
    // exists in this monorepo anymore.
    foreach (['.env', 'phpnitro.yml'] as $file) {
        copy(PHPX_TOOL_ROOT . '/' . $file, $targetDir . '/' . $file);
        echo "Copied {$file} to {$targetDir}/{$file}\n";
    }

    file_put_contents($targetDir . '/composer.json', newProjectComposerJson());
    echo "Wrote {$targetDir}/composer.json (phpnitro/* packages as Packagist dependencies)\n";

    resetPagesForNewProject($targetDir);

    $platforms = $all ? 'android, ios, linux, macos, windows' : 'android, ios';
    echo "Project scaffolded at {$targetDir} ({$platforms})\n";
    if (!$all) {
        echo "Tip: re-run with --all to also scaffold linux/ macos/ windows/ (still pre-alpha — see their own README.md)\n";
    }
    echo "Next: cd {$directory} && composer install && phpx make:page Home && phpx serve\n";
}

/**
 * A fresh, minimal composer.json for a scaffolded project — the
 * phpnitro/* packages as ordinary version-constrained dependencies
 * (resolved from Packagist into vendor/), not a copy of this monorepo's
 * own composer.json (whose autoload map points at packages/*, which no
 * longer exists in a new project).
 */
function newProjectComposerJson(): string
{
    // Only the core rendering package is a hard dependency — a blank
    // project has no database, no Firebase project, no country picker yet.
    // phpnitro/database, phpnitro/firebase, phpnitro/countries,
    // phpnitro/preferences, phpnitro/format are real Packagist packages a
    // developer adds with a plain `composer require phpnitro/<name>` the
    // moment their app actually needs one — the same relationship a Flutter
    // project has with pub.dev packages, not something bundled upfront.
    return json_encode([
        'license' => 'MIT',
        'require' => [
            'php' => '>=8.1',
            'phpnitro/ui' => '^2.0',
            'symfony/http-foundation' => '^8.1',
            'symfony/dotenv' => '^8.1',
            'symfony/yaml' => '^8.1',
        ],
        'require-dev' => [
            'phpunit/phpunit' => '^13.2',
            'phpstan/phpstan' => '^2.1',
        ],
        'autoload' => [
            'psr-4' => [
                'Engine\\App\\' => 'lib/pages/',
                'Backend\\' => 'lib/backend/src/',
            ],
        ],
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
}

/**
 * A scaffolded project has no `:engine` module of its own (unlike this
 * monorepo, which develops android/engine/ in place) — JitPack's own
 * Maven repository is where com.github.phpnitro:android-engine resolves
 * from instead. Everything else (Google/Maven Central, the plugin
 * management block) mirrors this monorepo's own android/settings.gradle.kts.
 */
function newProjectAndroidSettingsGradleKts(): string
{
    return <<<'GRADLE'
    pluginManagement {
        repositories {
            google()
            mavenCentral()
            gradlePluginPortal()
        }
    }

    dependencyResolutionManagement {
        repositories {
            google()
            mavenCentral()
            maven("https://jitpack.io")
        }
    }

    rootProject.name = "app"
    include(":app")

    GRADLE;
}

/**
 * Only the com.android.application plugin — a scaffolded project has no
 * com.android.library module of its own to declare `apply false` for
 * (unlike this monorepo's own android/build.gradle.kts, which also
 * declares com.android.library for android/engine/).
 */
function newProjectAndroidBuildGradleKts(): string
{
    return <<<'GRADLE'
    plugins {
        id("com.android.application") version "8.7.2" apply false
        id("org.jetbrains.kotlin.android") version "2.0.21" apply false
    }

    GRADLE;
}

/**
 * A blank project's manifest — no capability-specific permission (camera,
 * location, Bluetooth, contacts, NFC, billing...) is declared until the
 * developer's own screens actually use one; :engine already contributes
 * android.permission.INTERNET on its own (PhpServer always needs it), so
 * there is nothing to add here for that. The single activity-alias below
 * is NOT optional the way it is in the demo app: :engine's own
 * NativeRenderPocActivity declares no MAIN/LAUNCHER intent-filter (an app
 * decides its own entry point), so without this the app would install but
 * never appear on the home screen at all.
 */
function newProjectAndroidManifestXml(): string
{
    return <<<'XML'
    <manifest xmlns:android="http://schemas.android.com/apk/res/android">

        <application
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:usesCleartextTraffic="true">

            <!-- Makes the app launchable — see this function's own docblock.
                 Add your own <uses-permission> above this <application> tag
                 as your screens need one (Engine\Device\* docblocks say
                 which permission each capability requires), and re-declare
                 com.phpnitro.engine.MainActivity here with your own
                 intent-filter if you need deep linking (see this monorepo's
                 own android/app/src/main/AndroidManifest.xml for an example
                 of both). -->
            <activity-alias
                android:name=".MainActivityDefault"
                android:targetActivity="com.phpnitro.engine.NativeRenderPocActivity"
                android:icon="@mipmap/ic_launcher"
                android:roundIcon="@mipmap/ic_launcher_round"
                android:enabled="true"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity-alias>
        </application>
    </manifest>

    XML;
}

/**
 * This framework's own lib/pages/ holds demo pages, useful for developing
 * phpx itself — but a new project should start with an empty canvas, the
 * developer creates their own pages via `phpx make:page`. Strips the demo
 * pages + their routes from the freshly-copied scaffold (never touches
 * PHPX_TOOL_ROOT itself).
 */
function resetPagesForNewProject(string $targetDir): void
{
    $appDir = $targetDir . '/lib/pages';
    foreach (glob($appDir . '/*.php') ?: [] as $file) {
        unlink($file);
    }
    // A fresh scaffold still needs ONE working screen — public/index.php's
    // /native/layout-demo route (rewritten below) always falls back to
    // NativeHomeScreen for any unmatched ?screen=, including the very
    // first request NativeRenderPocActivity ever makes. Leaving lib/pages/
    // app/ completely empty would 500 on that first request instead of
    // showing a real, if minimal, screen — the same reason `flutter
    // create` ships a working counter app instead of a blank main.dart.
    file_put_contents($appDir . '/NativeHomeScreen.php', nativeHomeScreenTemplate());

    $indexPath = $targetDir . '/public/index.php';
    $content = file_get_contents($indexPath);
    if ($content === false) {
        phpxFail("unable to read {$indexPath}");
    }

    $content = preg_replace('/^use Engine\\\\App\\\\[A-Za-z]+;\n/m', '', $content);
    $content = preg_replace('/\$router = new Router\(\[\n(?:.*\n)*?\]\);/', "\$router = new Router([\n]);", $content);

    // The persistent bottom nav (BottomNavigation::make(AppNav::items(), ...))
    // references AppNav and demo routes stripped above — a fresh scaffold has
    // no pages yet, so drop those two trailing PageRenderer::render() args
    // entirely rather than pointing at a class that no longer exists.
    $content = preg_replace(
        '/,\s*BottomNavigation::make\([^;]*?\),\s*\$screen->showsBottomNav\(\)(,\s*\$screen)?(?=\);)/',
        '',
        $content,
    );

    // The /native/layout-demo route itself isn't just the match($screen)
    // table — it's ~240 lines seeding demo-specific state unconditionally
    // on every request (dismissible_items/reorder_items into $_SESSION,
    // stepperStep/stepperData, tapCount, loginError, firebaseError,
    // redirectScreen — all in service of screens just deleted above), so
    // trimming only the match table left dead calls like
    // NativeWidgetsDismissibleScreen::initialItems() still executing
    // before the match() even ran. Replaced wholesale with the minimal
    // core every screen actually needs (width/height, MediaQuery::init(),
    // action/scrollY, the lastHash short-circuit) — anchored on the
    // '/native/layout-demo' and '/_dev/version' markers so this survives
    // future edits to either route without re-deriving byte offsets.
    $startMarker = "if (\$path === '/native/layout-demo') {";
    $endMarker = "if (\$debug && \$path === '/_dev/version') {";
    $startPos = strpos($content, $startMarker);
    $endPos = strpos($content, $endMarker);
    if ($startPos !== false && $endPos !== false && $endPos > $startPos) {
        $content = substr($content, 0, $startPos) . minimalLayoutDemoRoute() . "\n" . substr($content, $endPos);
    }

    file_put_contents($indexPath, $content);

    // lib/backend/src/{Controller,Repository,Service,Entity} hold this
    // demo's OWN backend (FcmController, UploadController's image-upload
    // pipeline, VisitRepository's visit counter...) — every .php file goes
    // the same way lib/pages's demo screens just did above, README.md
    // left in place (each explains what belongs in that folder, not what
    // USED to).
    foreach (['Controller', 'Repository', 'Service', 'Entity'] as $layer) {
        foreach (glob("{$targetDir}/lib/backend/src/{$layer}/*.php") ?: [] as $file) {
            unlink($file);
        }
    }
    file_put_contents("{$targetDir}/lib/backend/src/Kernel.php", minimalKernelTemplate());

    // assets/audio/beep.wav only exists for NativeWidgetsMediaScreen.php's
    // AudioPlayer demo, just deleted above along with every other demo
    // screen — assets/README.md (the actual generic guidance) stays.
    $demoAudioDir = "{$targetDir}/assets/audio";
    if (is_dir($demoAudioDir)) {
        foreach (glob("{$demoAudioDir}/*") ?: [] as $file) {
            unlink($file);
        }
        rmdir($demoAudioDir);
    }
}

/**
 * lib/backend/src/Kernel.php — no demo routes/Controller imports, and
 * nothing to hand-edit either: every class under lib/backend/src/Controller/
 * with a handle(Request): Response method is discovered at request time
 * (Engine\AutoRouter::discover()) and reachable at /api/<kebab-name> (the
 * Controller paired with a root page is reachable at bare /api — see
 * AutoRouter::routeKey()'s 'home' fallback). `phpx make:page` only needs to
 * create the file; there is nothing left here for it to touch.
 */
function minimalKernelTemplate(): string
{
    return <<<'PHP'
    <?php

    namespace Backend;

    use Engine\AutoRouter;
    use Symfony\Component\HttpFoundation\JsonResponse;
    use Symfony\Component\HttpFoundation\Request;
    use Symfony\Component\HttpFoundation\Response;

    /**
     * Routes an already-built Request to a Controller and returns the Response.
     * Called in-process from the single front controller (public/index.php) —
     * no second server/port, backend/ has no public/ of its own. Add a
     * Controller under lib/backend/src/Controller/ (phpx make:page does this
     * for you) and it's reachable the moment the file exists — no route to
     * register here.
     */
    final class Kernel
    {
        public function handle(Request $request): Response
        {
            $path = $request->getPathInfo();
            $key = $path === '/api' ? 'home' : ltrim(substr($path, strlen('/api/')), '/');

            $controllers = AutoRouter::discover(
                __DIR__ . '/Controller',
                __NAMESPACE__ . '\\Controller',
                ['Controller'],
                'handle',
            );

            if (!isset($controllers[$key])) {
                return new JsonResponse(['error' => 'Not found'], 404);
            }

            return (new $controllers[$key]())->handle($request);
        }
    }

    PHP;
}

/**
 * The minimal core of /native/layout-demo every screen — including one
 * the developer hasn't written yet — actually needs: dp width/height (and
 * MediaQuery::init(), so a widget nested under the screen's own build()
 * can still read it), ?action=/?scroll_y= passthrough, and the
 * incremental-rendering "unchanged" short-circuit (Canvas::
 * stableHash()). Demo-specific bootstrapping (session-seeded lists,
 * multi-step form state, third-party auth error strings) belongs in a
 * developer's OWN screen, not this route — see any Native*Screen.php this
 * framework ships for the pattern. Screens are discovered straight from
 * lib/pages/ (Engine\AutoRouter::discover()) — a new Page/Screen class is
 * reachable at ?screen=<kebab-name> the moment the file exists, no match()
 * arm to add.
 */
function minimalLayoutDemoRoute(): string
{
    return <<<'PHP'
    if ($path === '/native/layout-demo') {
        header('Content-Type: application/json');
        // Without this, a fatal error anywhere below (a screen's build(),
        // a typo'd class name, a missing use import) falls through to
        // whatever HTML error handler the app bootstrap installed earlier
        // — the Content-Type header above is already locked in, so the
        // client receives an HTML body labeled application/json, fails to
        // parse it, and shows nothing with zero indication of why. This
        // replaces the handler for the rest of this request and gives
        // callers (NativeRenderPocActivity, PhpNitro Studio's Design mode)
        // a real {"error": {...}} shape to detect and display instead.
        set_exception_handler(static function (\Throwable $e) use ($debug): void {
            http_response_code(500);
            $error = ['class' => $e::class, 'message' => $e->getMessage()];
            if ($debug) {
                $error['file'] = $e->getFile();
                $error['line'] = $e->getLine();
                $error['trace'] = $e->getTraceAsString();
            }
            echo json_encode(['error' => $error], JSON_THROW_ON_ERROR);
        });

        // Only ever set by the embedded PhpServer.kt that runs this exact
        // php -S process on a real device — never by phpx serve (dev/CLI)
        // or PhpNitro Studio/Go, so this never blocks local development.
        // See PhpServer.kt's own accessToken docblock for the full threat
        // model this closes (another app on the SAME phone port-scanning
        // 127.0.0.1 and driving every action behind this one route with
        // zero prior knowledge otherwise).
        $expectedToken = getenv('PHPNITRO_ACCESS_TOKEN');
        if ($expectedToken !== false && $expectedToken !== '') {
            $providedToken = $_SERVER['HTTP_X_PHPNITRO_TOKEN'] ?? '';
            if (!hash_equals($expectedToken, $providedToken)) {
                http_response_code(403);
                echo json_encode(['error' => ['class' => 'Forbidden', 'message' => 'Jeton manquant ou invalide.']], JSON_THROW_ON_ERROR);
                exit;
            }
        }

        $renderStart = microtime(true);

        $screenWidth = (float) ($_GET['width'] ?? 360);
        $screenHeight = (float) ($_GET['height'] ?? 720);
        \Engine\Native\MediaQuery::init($screenWidth, $screenHeight);
        $screen = $_GET['screen'] ?? 'home';
        $action = $_GET['action'] ?? null;
        $scrollY = (float) ($_GET['scroll_y'] ?? 0);

        $screens = \Engine\AutoRouter::discover(
            dirname(__DIR__) . '/lib/pages',
            'Engine\\App',
            ['Page', 'Screen'],
            'build',
        );
        $pageClass = $screens[$screen] ?? ($screens['home'] ?? \Engine\App\NativeHomeScreen::class);
        $tree = $pageClass::build($screenWidth, $screenHeight);

        $contentSize = $tree->layout(new Constraints($screenWidth, $screenWidth, 0, Constraints::INFINITY));

        $canvas = new Canvas();
        $canvas->setContentHeight($contentSize->height);
        $tree->paint($canvas, 0, 0);
        $canvas->setRenderTimeMs((microtime(true) - $renderStart) * 1000);

        $hash = $canvas->stableHash();
        if (($_GET['lastHash'] ?? null) === $hash) {
            echo json_encode(['unchanged' => true, 'hash' => $hash]);
        } else {
            echo $canvas->toJson();
        }
        exit;
    }

    PHP;
}

/**
 * A real, working starter screen — not an empty canvas — so `phpx new` +
 * `composer install` + `phpx serve` produces something on screen
 * immediately, the same "you get a running app on the first try" promise
 * `flutter create`'s default counter app makes.
 */
function nativeHomeScreenTemplate(): string
{
    return <<<'PHP'
    <?php

    namespace Engine\App;

    use Engine\Native\Scaffold;
    use Engine\Native\Center;
    use Engine\Native\Widget;
    use Engine\Native\Text;
    use Engine\Native\Tokens;

    final class NativeHomeScreen
    {
        public static function build(float $screenWidth, float $screenHeight): Widget
        {
            return new Scaffold(
                new Center(new Text('Bienvenue sur PhpNitro', Tokens::TEXT_TITLE, Tokens::ink()->toHex(), bold: true)),
                $screenWidth,
                $screenHeight,
            );
        }
    }

    PHP;
}

/**
 * @param string[] $skip Directory/file names to skip entirely.
 */
/**
 * $minifyPhp is off by default (used as-is by cmdNew(), which is scaffolding
 * a project a developer is meant to read/edit — minifying there would be
 * actively hostile) and only turned on by cmdBundleAndroid(), where the
 * goal is exactly the opposite: ship as little readable source as possible
 * in the APK.
 */
function copyDirectory(string $source, string $destination, array $skip = [], bool $minifyPhp = false): void
{
    if (!is_dir($source)) {
        return;
    }

    mkdir($destination, 0777, true);

    foreach (scandir($source) as $entry) {
        if ($entry === '.' || $entry === '..' || in_array($entry, $skip, true)) {
            continue;
        }

        $sourcePath = "{$source}/{$entry}";
        $destinationPath = "{$destination}/{$entry}";

        if (is_dir($sourcePath)) {
            copyDirectory($sourcePath, $destinationPath, $skip, $minifyPhp);
        } elseif ($minifyPhp && str_ends_with($entry, '.php')) {
            file_put_contents($destinationPath, minifyPhpSource(file_get_contents($sourcePath)));
        } else {
            copy($sourcePath, $destinationPath);
        }
    }
}

/**
 * Strips comments/docblocks and collapses whitespace via PHP's own
 * tokenizer — NOT a real obfuscator (no identifier renaming, no string
 * encoding: a decompressed APK's .php files are still fully readable PHP,
 * just without the comments). Whitespace is collapsed
 * to a single space/newline rather than removed outright: PHP requires
 * separating whitespace between some adjacent tokens (`function foo`,
 * `return $x`), and token_get_all() never breaks up a string/heredoc body
 * into whitespace tokens, so this never touches content inside one.
 */
function minifyPhpSource(string $code): string
{
    $output = '';

    foreach (token_get_all($code) as $token) {
        if (!is_array($token)) {
            $output .= $token;
            continue;
        }

        [$id, $text] = $token;

        if ($id === T_COMMENT || $id === T_DOC_COMMENT) {
            $output .= str_contains($text, "\n") ? "\n" : '';
            continue;
        }

        if ($id === T_WHITESPACE) {
            $output .= str_contains($text, "\n") ? "\n" : ' ';
            continue;
        }

        $output .= $text;
    }

    return $output;
}

function cmdBundleAndroid(): void
{
    syncAssets();
    syncManifestToEnv();

    $androidResDir = PHPX_ROOT . '/android/app/src/main/res';
    syncManifestToAndroidStrings($androidResDir);
    syncManifestIcon($androidResDir);

    $staging = PHPX_ROOT . '/android/app/src/main/assets/www';

    if (is_dir($staging)) {
        passthruOrFail('rm -rf ' . escapeshellarg($staging));
    }
    mkdir($staging, 0777, true);

    // Mirrors the project root layout exactly (public/, lib/, packages/ all
    // at the same relative depth as this checkout) so the single
    // composer.json's autoload paths resolve identically between dev and the
    // bundle — no path rewriting, no vendor symlinks to flatten (there are
    // none: nothing here is a Composer path repository anymore).
    copyDirectory(PHPX_ROOT . '/public', "{$staging}/public", minifyPhp: true);
    copyDirectory(PHPX_ROOT . '/lib/pages', "{$staging}/lib/pages", minifyPhp: true);
    copyDirectory(PHPX_ROOT . '/lib/backend/src', "{$staging}/lib/backend/src", minifyPhp: true);
    // Engine\I18n\Translator::init() reads this directory directly (see
    // public/index.php) — missing it doesn't throw, Translator just finds
    // no locale file and every t() call silently falls back to the raw
    // key (its own documented behavior for a MISSING TRANSLATION, not
    // for "the whole locale file never shipped"), so this was invisible
    // in dev (php -S serves straight from the real lib/lang/) and only
    // showed up as "home.app_title" instead of real French text once
    // actually installed from a bundled APK. No minifyPhp: these return
    // a plain array literal, not executable logic worth minifying.
    if (is_dir(PHPX_ROOT . '/lib/lang')) {
        copyDirectory(PHPX_ROOT . '/lib/lang', "{$staging}/lib/lang", minifyPhp: false);
    }
    // Was a hardcoded per-package list — every package added after it was
    // last updated (this session: countries, preferences, connectivity,
    // launcher, diagnostics, format, socialauth) silently shipped a
    // composer.json autoload entry pointing at a directory that didn't
    // exist in the bundle, so those classes failed to autoload at runtime
    // only on-device (confirmed live: "Class ...\Preferences not found"),
    // never caught by php -l or PHPUnit since both ran against the
    // then-current package list, not a stale hardcoded one. glob() means
    // this can't go stale again.
    foreach (glob(PHPX_ROOT . '/packages/*/src', GLOB_ONLYDIR) ?: [] as $packageSrcDir) {
        $packageName = basename(dirname($packageSrcDir));
        copyDirectory($packageSrcDir, "{$staging}/packages/{$packageName}/src", minifyPhp: true);
    }
    copy(PHPX_ROOT . '/composer.json', "{$staging}/composer.json");

    // "env" without the dot: AAPT silently drops hidden files from assets.
    // APP_DEBUG is copied as-is from the dev .env (no longer forced to
    // false) — a crash on-device with APP_DEBUG=false only ever showed
    // "Erreur interne" with the real reason logged via error_log(),
    // wherever that ends up on Android (not easily readable without adb/
    // root). Set APP_DEBUG=false in .env yourself before a real release
    // build once you're done testing on-device.
    $env = file_get_contents(PHPX_ROOT . '/.env');
    file_put_contents($staging . '/env', $env);

    passthruOrFail(
        'composer install --no-dev --no-interaction --quiet --working-dir=' . escapeshellarg($staging),
    );
    passthruOrFail('rm -f ' . escapeshellarg($staging . '/composer.lock'));

    echo "Bundled into {$staging}\n";
}

/**
 * Reads applicationId straight out of android/app/build.gradle.kts — same
 * "never hardcode what a config file already declares" reasoning as
 * resolveOrInstallAndroidSdk() reading compileSdk from the same file.
 */
function readApplicationId(): string
{
    $buildGradle = file_get_contents(PHPX_ROOT . '/android/app/build.gradle.kts');
    if ($buildGradle === false) {
        phpxFail('android/app/build.gradle.kts not found — is this a phpx project?');
    }
    preg_match('/applicationId\s*=\s*"([^"]+)"/', $buildGradle, $match);

    return $match[1] ?? phpxFail('could not read applicationId from android/app/build.gradle.kts');
}

/**
 * Stages public/ + lib/ + packages/*\/src the exact same way
 * cmdBundleAndroid() does (so dev:push can never drift from what a real
 * build would ship), but skips `composer install` unless composer.json
 * itself changed since the last push — re-resolving/copying vendor/ on
 * every single edit would turn "hot" reload into a several-second wait for
 * the common case (editing one .php file, not adding a dependency).
 */
function stageForDevPush(): string
{
    syncAssets();
    syncManifestToEnv();

    $staging = PHPX_ROOT . '/android/app/src/main/assets/www';
    $stagedComposerJson = "{$staging}/composer.json";
    $composerChanged = !is_file($stagedComposerJson)
        || !is_dir("{$staging}/vendor")
        || file_get_contents($stagedComposerJson) !== file_get_contents(PHPX_ROOT . '/composer.json');

    passthruOrFail('rm -rf ' . escapeshellarg("{$staging}/public") . ' ' . escapeshellarg("{$staging}/lib"));
    copyDirectory(PHPX_ROOT . '/public', "{$staging}/public", minifyPhp: true);
    copyDirectory(PHPX_ROOT . '/lib/pages', "{$staging}/lib/pages", minifyPhp: true);
    copyDirectory(PHPX_ROOT . '/lib/backend/src', "{$staging}/lib/backend/src", minifyPhp: true);
    // See cmdBundleAndroid()'s identical copy — this staging function's
    // whole point is never drifting from what a real bundle ships.
    if (is_dir(PHPX_ROOT . '/lib/lang')) {
        copyDirectory(PHPX_ROOT . '/lib/lang', "{$staging}/lib/lang", minifyPhp: false);
    }

    foreach (glob(PHPX_ROOT . '/packages/*/src', GLOB_ONLYDIR) ?: [] as $packageSrcDir) {
        $packageName = basename(dirname($packageSrcDir));
        passthruOrFail('rm -rf ' . escapeshellarg("{$staging}/packages/{$packageName}/src"));
        copyDirectory($packageSrcDir, "{$staging}/packages/{$packageName}/src", minifyPhp: true);
    }

    if ($composerChanged) {
        echo "composer.json changed — reinstalling vendor/ (this push will be slower)...\n";
        copy(PHPX_ROOT . '/composer.json', $stagedComposerJson);
        passthruOrFail('composer install --no-dev --no-interaction --quiet --working-dir=' . escapeshellarg($staging));
        passthruOrFail('rm -f ' . escapeshellarg($staging . '/composer.lock'));
    }

    file_put_contents("{$staging}/env", (string) file_get_contents(PHPX_ROOT . '/.env'));

    return $staging;
}

/**
 * Pushes the staged PHP app straight into the running app's own
 * filesDir/www over adb, then broadcasts HotReloadReceiver so the
 * currently open screen refetches itself — no `assembleDebug`, no
 * `adb install`, no Activity restart, no lost screenStack/session. Relies
 * on PhpServer.kt's `-S` dev server re-reading/recompiling .php files
 * straight off disk (no persistent opcache) and on the app being a debug
 * build (`run-as` requires it). See HotReloadReceiver.kt for the other
 * half of this mechanism.
 */
function cmdDevPush(bool $watch): void
{
    if (resolveAdb() === '') {
        phpxFail('adb not found on PATH or under the Android SDK\'s platform-tools/ — connect a device via Android Studio/platform-tools first.');
    }

    $pkg = readApplicationId();

    do {
        $staging = stageForDevPush();

        // Separate adb shell invocations, no "&&"/sh -c nesting — adb
        // rejoins a multi-argument `adb shell a b c` into one string
        // before it reaches the device, which silently mangles nested
        // quoting/operators (a compound `sh -c 'rm ... && cp ...'` arrived
        // on-device as two unrelated top-level commands the one time this
        // was tried as a single call). One unambiguous command per call
        // sidesteps that rejoin entirely.
        $remote = '/data/local/tmp/phpnitro_hotreload';
        passthruOrFail('adb shell rm -rf ' . escapeshellarg($remote));
        passthruOrFail('adb push ' . escapeshellarg($staging) . ' ' . escapeshellarg($remote) . ' > /dev/null');
        passthruOrFail('adb shell run-as ' . escapeshellarg($pkg) . ' rm -rf files/www');
        passthruOrFail('adb shell run-as ' . escapeshellarg($pkg) . ' cp -r ' . escapeshellarg($remote) . ' files/www');
        passthruOrFail('adb shell rm -rf ' . escapeshellarg($remote));
        passthruOrFail('adb shell am broadcast -n ' . escapeshellarg("{$pkg}/.HotReloadReceiver") . ' > /dev/null');

        echo '[' . date('H:i:s') . "] Pushed to device, current screen refetched.\n";

        if ($watch) {
            waitForSourceChange();
        }
    } while ($watch);
}

/**
 * Polls mtimes across public/, lib/, packages/*\/src every second — no
 * inotify dependency (not guaranteed installed), and this only needs to
 * notice "something changed", not exactly what.
 */
function waitForSourceChange(): void
{
    $watchedDirs = array_merge(
        [PHPX_ROOT . '/public', PHPX_ROOT . '/lib'],
        glob(PHPX_ROOT . '/packages/*/src', GLOB_ONLYDIR) ?: [],
    );

    $baseline = latestMtime($watchedDirs);
    echo "Watching for changes (Ctrl+C to stop)...\n";
    while (latestMtime($watchedDirs) <= $baseline) {
        usleep(500_000);
    }
}

function latestMtime(array $dirs): int
{
    $latest = 0;
    foreach ($dirs as $dir) {
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS));
        foreach ($iterator as $file) {
            $latest = max($latest, $file->getMTime());
        }
    }

    return $latest;
}

/**
 * Buildozer-style one-command build: bundle + assemble, auto-installing a
 * JDK/Gradle (into ~/.local/share/phpnitro-tools, cached across
 * projects/runs — see resolveOrInstallJava()/resolveOrInstallGradle())
 * if neither is already on PATH — closes the exact gap this project hit
 * firsthand (manually locating/installing the SDK, downloading a
 * compatible Gradle, wiring ANDROID_HOME/JAVA_HOME by hand). Also
 * auto-installs the Android SDK itself (platform-tools + the exact
 * platform/build-tools this project targets) if none is found, accepting
 * Google's SDK license non-interactively — see resolveOrInstallAndroidSdk().
 */
function cmdBuildAndroid(string $variant): void
{
    if (!in_array($variant, ['debug', 'release'], true)) {
        phpxFail("unknown build variant: {$variant} (expected debug or release)");
    }

    // Must happen BEFORE resolveOrInstallGradle() — that function's own
    // "is a compatible gradle already on PATH" check runs `gradle
    // --version`, which needs a working `java` on PATH to even launch,
    // let alone the real build further down.
    $javaHome = resolveOrInstallJava();
    if ($javaHome !== '') {
        putenv("JAVA_HOME={$javaHome}");
        putenv('PATH=' . $javaHome . '/bin:' . getenv('PATH'));
    }

    $sdkRoot = resolveOrInstallAndroidSdk();
    $gradleBin = resolveOrInstallGradle();
    ensureLocalProperties($sdkRoot);

    cmdBundleAndroid();

    echo "Running gradle :app:assemble" . ucfirst($variant) . "...\n";
    passthruOrFail(sprintf(
        '%s :app:assemble%s --console=plain --project-dir=%s',
        escapeshellarg($gradleBin),
        ucfirst($variant),
        escapeshellarg(PHPX_ROOT . '/android'),
    ));

    $apkPath = "android/app/build/outputs/apk/{$variant}/app-{$variant}.apk";
    echo "Built: {$apkPath}\n";
}

/**
 * Android Gradle Plugin only ever reads the SDK location from
 * ANDROID_HOME/ANDROID_SDK_ROOT (if exported in the environment gradle
 * itself runs in) or android/local.properties's own "sdk.dir" key —
 * nothing else. A `-Dorg.gradle.project.android.sdk.dir=...` system
 * property (what cmdBuildAndroid() used to pass instead) is never read
 * by AGP; it silently did nothing, masked on any machine that already
 * had ANDROID_HOME exported or a local.properties left over from a
 * previous Android Studio open. Only writes the file if it doesn't
 * already exist — never overwrites a developer's own local.properties,
 * which can carry other machine-specific settings too.
 */
function ensureLocalProperties(string $sdkRoot): void
{
    $path = PHPX_ROOT . '/android/local.properties';
    if (is_file($path)) {
        return;
    }
    file_put_contents($path, "sdk.dir={$sdkRoot}\n");
}

/**
 * Checks the usual places (ANDROID_HOME/ANDROID_SDK_ROOT env, ~/Android/Sdk,
 * ~/Library/Android/sdk) first and uses that as-is if found. Otherwise
 * downloads Google's command-line tools straight into
 * ~/.local/share/phpnitro-tools/android-sdk (same persistent, XDG-honoring
 * location as resolveOrInstallGradle()) and uses `sdkmanager` to fetch
 * exactly the components this project needs: platform-tools, the exact
 * compileSdk platform, and a matching build-tools version — read straight
 * out of android/app/build.gradle.kts so this can never silently drift out
 * of sync with what the project actually targets. Accepts Google's SDK
 * license non-interactively (piped "y" answers) since there's no human
 * available to click through Android Studio's license dialog in a CI/build
 * context — this is the same license a developer would otherwise accept by
 * hand in Android Studio's SDK Manager once.
 */
/**
 * The "usual places" ANDROID_HOME/ANDROID_SDK_ROOT/~/Android/Sdk/
 * ~/Library/Android/sdk check, factored out since resolveOrInstallAndroidSdk()
 * (the "install if missing" path), doctor (the "just report" path), and
 * resolveAdb() (adb specifically lives under platform-tools/ inside
 * whatever this returns) all need the exact same answer to "is there
 * already an SDK on this machine, and where". Returns null, never
 * installs anything — that's resolveOrInstallAndroidSdk()'s job.
 */
function findExistingAndroidSdk(): ?string
{
    $sdkRoot = $_ENV['ANDROID_HOME'] ?? $_ENV['ANDROID_SDK_ROOT'] ?? null;
    foreach ([$sdkRoot, getenv('HOME') . '/Android/Sdk', getenv('HOME') . '/Library/Android/sdk'] as $candidate) {
        if ($candidate !== null && is_dir($candidate)) {
            return $candidate;
        }
    }

    return null;
}

/**
 * `adb` ships inside the Android SDK's own platform-tools/ — a fresh
 * SDK install (Android Studio, or resolveOrInstallAndroidSdk() itself)
 * doesn't always also add that directory to the shell's PATH, which is
 * exactly the "doctor says the SDK is there but adb isn't on PATH"
 * situation this project hit firsthand. Checks PATH first (respects
 * whatever the user already has), falls back to the resolved SDK's own
 * platform-tools/adb, and — only in that fallback case — exports that
 * directory onto PATH for the REST of this process, so every later
 * `passthruOrFail('adb ...')` call in the same command also finds it,
 * not just this one lookup. Returns '' if adb is genuinely nowhere to
 * be found.
 */
function resolveAdb(): string
{
    $onPath = trim((string) shell_exec('command -v adb 2>/dev/null'));
    if ($onPath !== '') {
        return $onPath;
    }

    $sdkRoot = findExistingAndroidSdk();
    if ($sdkRoot === null) {
        return '';
    }
    $platformTools = "{$sdkRoot}/platform-tools";
    $adb = "{$platformTools}/adb";
    if (!is_file($adb)) {
        return '';
    }

    putenv('PATH=' . $platformTools . ':' . getenv('PATH'));

    return $adb;
}

function resolveOrInstallAndroidSdk(): string
{
    $existing = findExistingAndroidSdk();
    if ($existing !== null) {
        return $existing;
    }

    $buildGradle = file_get_contents(PHPX_ROOT . '/android/app/build.gradle.kts');
    if ($buildGradle === false) {
        phpxFail('android/app/build.gradle.kts not found — is this a phpx project?');
    }
    preg_match('/compileSdk\s*=\s*(\d+)/', $buildGradle, $compileSdkMatch);
    $compileSdk = $compileSdkMatch[1] ?? phpxFail('could not read compileSdk from android/app/build.gradle.kts');
    $buildToolsVersion = "{$compileSdk}.0.0";

    $dataHome = getenv('XDG_DATA_HOME') ?: (getenv('HOME') . '/.local/share');
    $sdkRoot = "{$dataHome}/phpnitro-tools/android-sdk";
    $cmdlineToolsBin = "{$sdkRoot}/cmdline-tools/latest/bin";
    $sdkManager = "{$cmdlineToolsBin}/sdkmanager";

    if (!is_file($sdkManager)) {
        echo "No Android SDK found — installing command-line tools into {$sdkRoot} (one-time)...\n";
        mkdir($sdkRoot, 0777, true);
        $zipPath = "{$sdkRoot}/cmdline-tools.zip";
        // Version number in the URL is Google's internal build id for this
        // package, unrelated to any Android/AGP version — pinned to a known
        // working release rather than "latest" (no stable latest-alias URL
        // exists for this specific artifact).
        passthruOrFail(sprintf(
            'curl -L --retry 5 --retry-delay 3 -o %s %s',
            escapeshellarg($zipPath),
            escapeshellarg('https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip'),
        ));
        $extractedDir = "{$sdkRoot}/cmdline-tools-extracted";
        passthruOrFail('unzip -q ' . escapeshellarg($zipPath) . ' -d ' . escapeshellarg($extractedDir));
        unlink($zipPath);
        // The zip's own top-level folder is named "cmdline-tools" — sdkmanager
        // requires it to live specifically at .../cmdline-tools/latest/ (its
        // own relative-path lookups break if it's directly at cmdline-tools/).
        mkdir("{$sdkRoot}/cmdline-tools", 0777, true);
        rename("{$extractedDir}/cmdline-tools", "{$sdkRoot}/cmdline-tools/latest");
        rmdir($extractedDir);
    }

    echo "Installing platform-tools, platforms;android-{$compileSdk}, build-tools;{$buildToolsVersion}...\n";
    $components = escapeshellarg('platform-tools')
        . ' ' . escapeshellarg("platforms;android-{$compileSdk}")
        . ' ' . escapeshellarg("build-tools;{$buildToolsVersion}");
    passthruOrFail(sprintf(
        'yes | %s --sdk_root=%s --licenses > /dev/null 2>&1; %s --sdk_root=%s %s',
        escapeshellarg($sdkManager),
        escapeshellarg($sdkRoot),
        escapeshellarg($sdkManager),
        escapeshellarg($sdkRoot),
        $components,
    ));

    return $sdkRoot;
}

/**
 * A `gradle` already on PATH satisfying the project's minimum (read from
 * android/build.gradle.kts's AGP version — AGP 8.7+ requires Gradle 8.9+)
 * is used as-is. Otherwise downloads the pinned version straight into
 * ~/.local/share/phpnitro-tools/gradle-<version>, once — every later call
 * across every project on this machine reuses it, never re-downloaded,
 * never left in a wiped /tmp scratch dir (XDG_DATA_HOME is honored since
 * that's the standard override for "persistent app data" on Linux).
 */
function resolveOrInstallGradle(): string
{
    $pinnedVersion = '8.10.2';
    $minMajorMinor = '8.9';

    $existing = trim((string) shell_exec('command -v gradle 2>/dev/null'));
    if ($existing !== '') {
        $versionOutput = (string) shell_exec(escapeshellarg($existing) . ' --version 2>/dev/null');
        if (preg_match('/Gradle (\d+\.\d+)/', $versionOutput, $m) && version_compare($m[1], $minMajorMinor, '>=')) {
            return $existing;
        }
    }

    $dataHome = getenv('XDG_DATA_HOME') ?: (getenv('HOME') . '/.local/share');
    $toolsDir = "{$dataHome}/phpnitro-tools";
    $gradleHome = "{$toolsDir}/gradle-{$pinnedVersion}";
    $gradleBin = "{$gradleHome}/bin/gradle";

    if (is_file($gradleBin)) {
        return $gradleBin;
    }

    echo "No compatible Gradle found (need >= {$minMajorMinor}) — downloading {$pinnedVersion} into {$toolsDir} (one-time)...\n";
    mkdir($toolsDir, 0777, true);
    $zipPath = "{$toolsDir}/gradle-{$pinnedVersion}-bin.zip";
    passthruOrFail(sprintf(
        'curl -L --retry 5 --retry-delay 3 -o %s %s',
        escapeshellarg($zipPath),
        escapeshellarg("https://services.gradle.org/distributions/gradle-{$pinnedVersion}-bin.zip"),
    ));
    passthruOrFail('unzip -q ' . escapeshellarg($zipPath) . ' -d ' . escapeshellarg($toolsDir));
    unlink($zipPath);

    if (!is_file($gradleBin)) {
        phpxFail("Gradle download succeeded but {$gradleBin} is missing — corrupt archive?");
    }

    return $gradleBin;
}

/**
 * Same "already on PATH and new enough? use it. Otherwise download a
 * pinned, cached copy" shape as resolveOrInstallGradle()/
 * resolveOrInstallAndroidSdk() — the last piece of the Android toolchain
 * that still needed installing by hand. Returns '' when the system
 * `java` already satisfies the minimum version (no JAVA_HOME override
 * needed, gradle will find it on PATH as-is), or the JDK's home
 * directory when a fresh one was downloaded/reused from cache — the
 * caller is expected to `putenv('JAVA_HOME=...')` and prepend
 * "{home}/bin" to PATH in that case, BEFORE calling
 * resolveOrInstallGradle() (which itself needs a working `java` on PATH
 * just to run `gradle --version`).
 *
 * Eclipse Temurin (the OpenJDK build GitHub Actions' own setup-java
 * action defaults to) via adoptium.net's stable "latest binary for this
 * major version" redirect endpoint — no manual version-number tracking
 * needed the way Gradle's own pinned-version URL requires.
 *
 * Honesty: the "already have a compatible java" early-return path is
 * exercised every time doctor/build:android run anywhere Java 17+ is
 * already present (which is everywhere this project's own CI runs,
 * since actions/setup-java always provides one first) — but the actual
 * download-and-extract branch below has never been exercised anywhere,
 * CI included, only reviewed by hand against Adoptium's documented
 * archive layout. Written deliberately the same shape as
 * resolveOrInstallGradle()/resolveOrInstallAndroidSdk() (which HAVE run
 * for real) to keep the risk as low as reasonably possible, not because
 * it's been proven to work yet.
 */
function resolveOrInstallJava(): string
{
    $minMajor = 17;

    $existing = trim((string) shell_exec('command -v java 2>/dev/null'));
    if ($existing !== '') {
        $versionOutput = (string) shell_exec('java -version 2>&1');
        if (preg_match('/version "(\d+)/', $versionOutput, $m) && (int) $m[1] >= $minMajor) {
            return '';
        }
    }

    $dataHome = getenv('XDG_DATA_HOME') ?: (getenv('HOME') . '/.local/share');
    $toolsDir = "{$dataHome}/phpnitro-tools";
    $jdkRoot = "{$toolsDir}/jdk-{$minMajor}";
    // macOS Temurin archives are a "bundle" (bin/java lives under
    // Contents/Home/, not at the top level) — Linux archives aren't.
    // Probing for the real layout rather than branching on PHP_OS_FAMILY
    // means a corrupt/unexpected archive fails loudly instead of
    // returning a JAVA_HOME with no java in it.
    $jdkHome = is_file("{$jdkRoot}/Contents/Home/bin/java") ? "{$jdkRoot}/Contents/Home" : $jdkRoot;
    if (is_file("{$jdkHome}/bin/java")) {
        return $jdkHome;
    }

    $os = match (PHP_OS_FAMILY) {
        'Darwin' => 'mac',
        'Windows' => 'windows',
        default => 'linux',
    };
    $machine = trim((string) shell_exec('uname -m 2>/dev/null'));
    $arch = match ($machine) {
        'x86_64', 'AMD64' => 'x64',
        'aarch64', 'arm64' => 'aarch64',
        default => phpxFail("unsupported architecture for an auto-installed JDK: '{$machine}' — install a JDK {$minMajor}+ yourself and make sure `java` is on PATH"),
    };

    echo "No compatible Java found (need >= {$minMajor}) — downloading a Temurin JDK into {$toolsDir} (one-time)...\n";
    mkdir($toolsDir, 0777, true);
    $archivePath = "{$toolsDir}/jdk-{$minMajor}.tar.gz";
    passthruOrFail(sprintf(
        'curl -L --retry 5 --retry-delay 3 -o %s %s',
        escapeshellarg($archivePath),
        escapeshellarg("https://api.adoptium.net/v3/binary/latest/{$minMajor}/ga/{$os}/{$arch}/jdk/hotspot/normal/eclipse"),
    ));
    $extractedDir = "{$toolsDir}/jdk-{$minMajor}-extracted";
    mkdir($extractedDir, 0777, true);
    passthruOrFail('tar -xzf ' . escapeshellarg($archivePath) . ' -C ' . escapeshellarg($extractedDir));
    unlink($archivePath);

    // The archive's own single top-level folder is named after the exact
    // patch version Adoptium resolved "latest" to (e.g. jdk-17.0.9+9) —
    // renamed to the version-agnostic $jdkRoot so callers never need to
    // know that exact string.
    $entries = array_values(array_diff(scandir($extractedDir), ['.', '..']));
    if (count($entries) !== 1 || !is_dir("{$extractedDir}/{$entries[0]}")) {
        phpxFail("JDK download succeeded but {$extractedDir} doesn't have the expected single top-level folder — corrupt archive?");
    }
    rename("{$extractedDir}/{$entries[0]}", $jdkRoot);
    rmdir($extractedDir);

    $jdkHome = is_file("{$jdkRoot}/Contents/Home/bin/java") ? "{$jdkRoot}/Contents/Home" : $jdkRoot;
    if (!is_file("{$jdkHome}/bin/java")) {
        phpxFail("JDK download succeeded but no bin/java found under {$jdkRoot} — corrupt archive or unexpected layout?");
    }

    return $jdkHome;
}

/**
 * One line of `phpx doctor` output — mirrors `flutter doctor`'s [✓]/[✗]
 * format. $required means phpx itself is broken without it (php, composer);
 * a failing non-required check only means one specific command
 * (build:android, dev:push) won't work.
 */
function doctorCheck(string $label, bool $ok, string $detail, bool $required = true): bool
{
    $icon = $ok ? '✓' : ($required ? '✗' : '!');
    echo "  [{$icon}] {$label}" . ($detail !== '' ? " — {$detail}" : '') . "\n";

    return $ok || !$required;
}

/**
 * Checks the local machine's readiness for phpx development — no
 * installing, unlike resolveOrInstallGradle()/resolveOrInstallAndroidSdk(),
 * which cmdBuildAndroid() already calls (and which auto-install Gradle/the
 * SDK on demand) — this command's whole point is to tell you WHAT'S missing
 * before you hit a build failure explaining it, the same job `flutter
 * doctor` does for a Flutter install.
 */
function cmdDoctor(): void
{
    $allOk = true;

    echo "PHP\n";
    $allOk = doctorCheck('PHP >= 8.1', version_compare(PHP_VERSION, '8.1.0', '>='), 'found ' . PHP_VERSION) && $allOk;
    foreach (['pdo_sqlite', 'curl', 'mbstring', 'json', 'tokenizer', 'zip'] as $extension) {
        $allOk = doctorCheck("ext-{$extension}", extension_loaded($extension), '') && $allOk;
    }

    echo "\nPHP tooling\n";
    $composer = trim((string) shell_exec('command -v composer 2>/dev/null'));
    $allOk = doctorCheck('Composer', $composer !== '', $composer !== '' ? $composer : 'not found on PATH — https://getcomposer.org') && $allOk;

    echo "\nAndroid toolchain (only needed for build:android / dev:push)\n";
    $java = trim((string) shell_exec('command -v java 2>/dev/null'));
    doctorCheck('Java (JDK)', $java !== '', $java !== '' ? $java : 'not found — build:android downloads a Temurin JDK automatically on first use', required: false);

    $gradle = trim((string) shell_exec('command -v gradle 2>/dev/null'));
    if ($gradle === '') {
        $dataHome = getenv('XDG_DATA_HOME') ?: (getenv('HOME') . '/.local/share');
        $cachedGradle = glob("{$dataHome}/phpnitro-tools/gradle-*/bin/gradle");
        $gradle = $cachedGradle[0] ?? '';
    }
    doctorCheck('Gradle', $gradle !== '', $gradle !== '' ? $gradle : 'not found — build:android downloads it automatically on first use', required: false);

    $sdkRoot = findExistingAndroidSdk();
    doctorCheck('Android SDK', $sdkRoot !== null, $sdkRoot ?? 'not found — build:android downloads platform-tools automatically on first use', required: false);

    $adb = resolveAdb();
    doctorCheck('adb', $adb !== '', $adb !== '' ? $adb : 'not found on PATH or under the SDK\'s platform-tools/ — only needed for dev:push against a real device', required: false);

    // Only checked if an android/ dir exists in the current project —
    // doctor also runs fine from a directory that isn't a scaffolded
    // PhpNitro project at all (just checking machine-wide tooling), where
    // this file could never make sense to ask for. Not required: debug
    // builds sign with a throwaway key and work without it; this is
    // purely to surface the release-signing gap BEFORE `build:android
    // release` fails on it, rather than only via that failure — see
    // android/keystore.properties.example, already scaffolded by `phpx
    // new`, for how a developer actually fills this in.
    if (is_dir(getcwd() . '/android')) {
        echo "\nAndroid release signing (only needed for build:android release)\n";
        $keystoreProps = getcwd() . '/android/keystore.properties';
        doctorCheck(
            'android/keystore.properties',
            is_file($keystoreProps),
            is_file($keystoreProps) ? 'found' : 'missing — build:android release will fail signing validation without it, see android/keystore.properties.example',
            required: false,
        );
    }

    echo "\n";
    echo $allOk
        ? "phpx is ready — every required tool is present.\n"
        : "phpx is missing required tools — see [✗] lines above.\n";

    if (!$allOk) {
        exit(1);
    }
}

$command = $argv[1] ?? null;

switch ($command) {
    case 'make:page':
        cmdMakePage($argv[2] ?? phpxFail('usage: phpx make:page <Name>'));
        break;
    case 'make:entity':
        cmdMakeEntity($argv[2] ?? phpxFail('usage: phpx make:entity <Name>'));
        break;
    case 'make:auth':
        cmdMakeAuth();
        break;
    case 'make:migration':
        cmdMakeMigration($argv[2] ?? phpxFail('usage: phpx make:migration <name>'));
        break;
    case 'migrate':
        cmdMigrate();
        break;
    case 'migrate:rollback':
        cmdMigrateRollback();
        break;
    case 'migrate:status':
        cmdMigrateStatus();
        break;
    case 'serve':
        cmdServe((int) ($argv[2] ?? 8090));
        break;
    case 'new':
        cmdNew($argv[2] ?? phpxFail('usage: phpx new <directory> [--all]'), in_array('--all', $argv, true));
        break;
    case 'bundle:android':
        cmdBundleAndroid();
        break;
    case 'dev:push':
        cmdDevPush(in_array('--watch', $argv, true));
        break;
    case 'build:android':
        cmdBuildAndroid($argv[2] ?? 'debug');
        break;
    case 'payments':
        cmdPayments();
        break;
    case 'maps':
        cmdMaps();
        break;
    case 'icon':
        cmdIcon();
        break;
    case 'firebase':
        cmdFirebase();
        break;
    case 'docs:api':
        cmdGenerateApiDocs();
        break;
    case 'doctor':
        cmdDoctor();
        break;
    default:
        printPhpxUsage();
        if ($command !== null) {
            fwrite(STDERR, "phpx: commande inconnue : {$command}\n");
        }
        exit(1);
}
