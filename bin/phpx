#!/usr/bin/env php
<?php

/**
 * phpx — CLI for PhpNitro, the PHP mobile framework.
 *
 * Commands:
 *   phpx make:screen <Name> [route]   Generate a new Screen and register its route
 *   phpx serve [port]                 Serve lib/pages/ + lib/backend/ together (defaults to 8090)
 *   phpx serve:backend [port]         Serve lib/backend/ alone (defaults to 8091, API-only dev)
 *   phpx new <directory>              Scaffold a new project: android/ ios/ lib/{pages,backend} .env assets/
 *   phpx bundle:android               Copy lib/ + assets/ + .env into the Android app
 */

define('PHPX_ROOT', dirname(__DIR__));

function phpxFail(string $message): never
{
    fwrite(STDERR, "phpx: {$message}\n");
    exit(1);
}

function passthruOrFail(string $command): void
{
    passthru($command, $exitCode);
    if ($exitCode !== 0) {
        phpxFail("command failed ({$exitCode}): {$command}");
    }
}

function screenClassName(string $name): string
{
    $className = str_replace([' ', '-', '_'], '', ucwords(preg_replace('/[\s\-_]+/', ' ', $name)));

    return str_ends_with($className, 'Page') ? $className : $className . 'Page';
}

function defaultRoute(string $className): string
{
    $base = preg_replace('/Page$/', '', $className);
    $kebab = strtolower(preg_replace('/(?<!^)[A-Z]/', '-$0', $base));

    return $kebab === '' ? '/' : '/' . $kebab;
}

function screenTemplate(string $className): string
{
    return <<<PHP
    <?php

    namespace Engine\App;

    use Engine\Column;
    use Engine\Screen;
    use Engine\Text;
    use Engine\Widget;

    final class {$className} extends Screen
    {
        protected function initialState(): array
        {
            return [];
        }

        public function build(): Widget
        {
            return Column::make([
                Text::make('{$className}', 'text-2xl font-bold text-gray-900 dark:text-gray-100'),
            ]);
        }
    }

    PHP;
}

function registerRoute(string $indexPath, string $className, string $route): void
{
    $content = file_get_contents($indexPath);
    if ($content === false) {
        phpxFail("unable to read {$indexPath}");
    }

    $useLine = "use Engine\\App\\{$className};\n";
    if (!str_contains($content, $useLine)) {
        $content = str_replace("use Engine\\Router;\n", $useLine . "use Engine\\Router;\n", $content);
    }

    $routeLine = "    '{$route}' => {$className}::class,\n";
    if (!str_contains($content, $routeLine)) {
        $content = str_replace("\$router = new Router([\n", "\$router = new Router([\n{$routeLine}", $content);
    }

    file_put_contents($indexPath, $content);
}

function cmdMakeScreen(string $name, ?string $route): void
{
    $className = screenClassName($name);
    $path = PHPX_ROOT . "/lib/pages/app/{$className}.php";

    if (is_file($path)) {
        phpxFail("screen already exists: {$path}");
    }

    $route ??= defaultRoute($className);

    file_put_contents($path, screenTemplate($className));
    echo "Created {$path}\n";

    registerRoute(PHPX_ROOT . '/lib/pages/public/index.php', $className, $route);
    echo "Registered route {$route} => Engine\\App\\{$className}\n";
}

/**
 * Copies assets/ into lib/pages/public/assets/ so both the dev server and the
 * Android bundle serve it the exact same way (a plain static file next to
 * tailwind.css — no special-casing in the router).
 */
function syncAssets(): void
{
    $source = PHPX_ROOT . '/assets';
    $destination = PHPX_ROOT . '/lib/pages/public/assets';

    if (is_dir($destination)) {
        passthruOrFail('rm -rf ' . escapeshellarg($destination));
    }

    copyDirectory($source, $destination, ['README.md']);
}

function cmdServe(string $dir, int $port, ?string $router): void
{
    syncAssets();

    $publicDir = PHPX_ROOT . "/{$dir}/public";
    if (!is_dir($publicDir)) {
        phpxFail("no public/ directory found at {$publicDir}");
    }

    $command = "php -S 127.0.0.1:{$port} -t " . escapeshellarg($publicDir);
    if ($router !== null) {
        $command .= ' ' . escapeshellarg($publicDir . '/' . $router);
    }

    passthruOrFail($command);
}

function cmdNew(string $directory): void
{
    // Resolved against the current working directory (like `composer create-project`
    // or `flutter create`) — a new project lives wherever the developer is
    // working, not nested inside this framework's own checkout.
    $targetDir = str_starts_with($directory, '/') ? $directory : getcwd() . '/' . $directory;

    if (is_dir($targetDir)) {
        phpxFail("directory already exists: {$targetDir}");
    }

    mkdir($targetDir, 0777, true);

    // `packages/` ships alongside `lib/` (not published to Packagist yet) so
    // lib/pages/composer.json's path repository ("../../packages/ui") keeps
    // resolving correctly in the new project — same relative shape as this
    // framework's own checkout. Once phpnitro/ui is on Packagist, new
    // projects won't need this local copy at all.
    foreach (['lib', 'packages', 'android', 'ios', 'assets', 'bin'] as $part) {
        $source = PHPX_ROOT . '/' . $part;
        $destination = $targetDir . '/' . $part;
        copyDirectory($source, $destination, [
            'vendor', 'node_modules', '.gradle', 'build', '.kotlin', 'local.properties', 'var',
        ]);
        echo "Copied {$part}/ to {$destination}\n";
    }

    copy(PHPX_ROOT . '/.env', $targetDir . '/.env');
    echo "Copied .env to {$targetDir}/.env\n";

    echo "Project scaffolded at {$targetDir}\n";
    echo "Next: cd {$directory} && composer install --working-dir=lib/pages && composer install --working-dir=lib/backend && bin/phpx serve\n";
}

/**
 * @param string[] $skip Directory/file names to skip entirely.
 */
function copyDirectory(string $source, string $destination, array $skip = []): void
{
    if (!is_dir($source)) {
        return;
    }

    mkdir($destination, 0777, true);

    foreach (scandir($source) as $entry) {
        if ($entry === '.' || $entry === '..' || in_array($entry, $skip, true)) {
            continue;
        }

        $sourcePath = "{$source}/{$entry}";
        $destinationPath = "{$destination}/{$entry}";

        if (is_dir($sourcePath)) {
            copyDirectory($sourcePath, $destinationPath, $skip);
        } else {
            copy($sourcePath, $destinationPath);
        }
    }
}

function cmdBundleAndroid(): void
{
    syncAssets();

    $staging = PHPX_ROOT . '/android/app/src/main/assets/www';

    if (is_dir($staging)) {
        passthruOrFail('rm -rf ' . escapeshellarg($staging));
    }
    mkdir($staging, 0777, true);

    // Mirrors the project root layout (lib/pages/ and lib/backend/ as
    // siblings under lib/) so the relative paths each front controller
    // uses to reach the other project and the shared root .env stay
    // identical between dev and the bundle.
    foreach (['app', 'public', 'composer.json', 'composer.lock'] as $entry) {
        $source = PHPX_ROOT . '/lib/pages/' . $entry;
        is_dir($source)
            ? copyDirectory($source, "{$staging}/lib/pages/{$entry}")
            : copy($source, "{$staging}/lib/pages/{$entry}");
    }

    foreach (['src', 'composer.json', 'composer.lock'] as $entry) {
        $source = PHPX_ROOT . '/lib/backend/' . $entry;
        is_dir($source)
            ? copyDirectory($source, "{$staging}/lib/backend/{$entry}")
            : copy($source, "{$staging}/lib/backend/{$entry}");
    }

    // The widget SDK package itself, copied as real files (not the symlink
    // Composer's path repository normally uses) — Android's AssetManager
    // can't follow symlinks when the bundle is later packaged into the APK.
    mkdir("{$staging}/packages/ui", 0777, true);
    copyDirectory(PHPX_ROOT . '/packages/ui/src', "{$staging}/packages/ui/src");
    copy(PHPX_ROOT . '/packages/ui/composer.json', "{$staging}/packages/ui/composer.json");

    // "env" without the dot: AAPT silently drops hidden files from assets.
    // Force APP_DEBUG=false in the shipped bundle regardless of the dev .env.
    $env = file_get_contents(PHPX_ROOT . '/.env');
    $env = preg_match('/^APP_DEBUG=/m', $env)
        ? preg_replace('/^APP_DEBUG=.*$/m', 'APP_DEBUG=false', $env)
        : $env . "\nAPP_DEBUG=false\n";
    file_put_contents($staging . '/env', $env);

    passthruOrFail(
        'composer install --no-dev --no-interaction --quiet --working-dir=' . escapeshellarg($staging . '/lib/pages'),
    );
    passthruOrFail(
        'composer install --no-dev --no-interaction --quiet --working-dir=' . escapeshellarg($staging . '/lib/backend'),
    );
    passthruOrFail('rm -f ' . escapeshellarg($staging . '/lib/pages/composer.lock'));
    passthruOrFail('rm -f ' . escapeshellarg($staging . '/lib/backend/composer.lock'));

    // Composer's path repository installs phpnitro/ui as a symlink — replace
    // it with a real copy (Android's AssetManager can't follow symlinks).
    $symlinkPath = $staging . '/lib/pages/vendor/phpnitro/ui';
    if (is_link($symlinkPath)) {
        $realTarget = realpath($symlinkPath);
        unlink($symlinkPath);
        copyDirectory($realTarget, $symlinkPath);
    }

    echo "Bundled lib/pages + lib/backend into {$staging}\n";
}

$command = $argv[1] ?? null;

switch ($command) {
    case 'make:screen':
        cmdMakeScreen($argv[2] ?? phpxFail('usage: phpx make:screen <Name> [route]'), $argv[3] ?? null);
        break;
    case 'serve':
        cmdServe('lib/pages', (int) ($argv[2] ?? 8090), 'router.php');
        break;
    case 'serve:backend':
        cmdServe('lib/backend', (int) ($argv[2] ?? 8091), null);
        break;
    case 'new':
        cmdNew($argv[2] ?? phpxFail('usage: phpx new <directory>'));
        break;
    case 'bundle:android':
        cmdBundleAndroid();
        break;
    default:
        phpxFail('usage: phpx <make:screen|serve|serve:backend|new|bundle:android> ...');
}
