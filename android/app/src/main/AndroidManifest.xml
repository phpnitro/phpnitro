<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Billing (Engine\Device\InAppPurchase) requires this exact permission
         string — Play Billing silently no-ops purchase flows without it. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Geofencing (Engine\Device\Geofence) needs fine location for the
         geofence itself; background location is only required for
         enter/exit transitions to fire while the app isn't in the
         foreground — Play Store review requires a declared justification
         for this permission, not added lightly. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Custom-scheme deep link (phpnitro://<path>), e.g.
                 phpnitro://product/42 opens /product/42 — see
                 MainActivity.kt's deepLinkPath(). A real HTTPS App Link
                 (android:autoVerify + a hosted .well-known/assetlinks.json)
                 needs a verified domain this environment doesn't have, so
                 this is scheme-based only for now, not domain-verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phpnitro" />
            </intent-filter>

            <!-- Real HTTPS App Link — android:autoVerify makes the OS check
                 https://app.example.com/.well-known/assetlinks.json at
                 install time before letting this filter claim the link
                 (docs/assetlinks.json.example has the exact format/SHA-256
                 fingerprint instructions). Replace "app.example.com" with a
                 real domain you control and host that file there — this
                 placeholder alone verifies against nothing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.example.com" />
            </intent-filter>

            <!-- NFC foreground dispatch (MainActivity.onResume) intercepts
                 tag scans before this filter ever matches while the app is
                 in front; TECH_DISCOVERED + NDEF catches any NDEF-formatted
                 tag without requiring a specific registered MIME type. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Dynamic app icon: the MAIN/LAUNCHER entry point moved here (off
             the target Activity itself) so it can switch between two
             mutually exclusive icons at runtime — Engine\Device\AppIcon::
             onClick() -> WebAppInterface.kt's setAppIcon() (or
             NativeDeviceBridge.kt's setAppIcon() from the native side)
             calls PackageManager.setComponentEnabledSetting() to enable
             one alias and disable the other.

             Both aliases target NativeRenderPocActivity, not MainActivity —
             the native render engine (docs/proposals/moteur-rendu-natif.md)
             is the app's real launcher now, not an opt-in preview: every
             production route (lib/pages/app/Native*Screen.php) reaches
             full parity with its WebView original gets that WebView page
             deleted (see e.g. HomePage.php's removal), so MainActivity's
             WebView pipeline is what's left over for the genuinely
             not-yet-portable pieces (camera preview, NFC foreground
             dispatch, VideoPlayer, interactive maps, animations —
             reachable from native screens via "Voir sur WebView" buttons,
             see NativeDeviceBridge.kt's openWebView()), not the default
             experience. MainActivity itself is untouched below — still a
             real, independently launchable Activity (deep links, NFC). -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".NativeRenderPocActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAlt"
            android:targetActivity=".NativeRenderPocActivity"
            android:icon="@mipmap/ic_launcher_alt"
            android:roundIcon="@mipmap/ic_launcher_alt_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The app's real production entry point as of this pass — see
             the activity-alias docblock above. android:launchMode
             ="singleTask" matches MainActivity's (re-tapping the launcher
             icon should resume the existing instance, not stack a second
             one on top). -->
        <activity
            android:name=".NativeRenderPocActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Foreground dispatch (onResume/onPause) intercepts tag
                 scans while this Activity is in front; this filter is
                 what catches a scan while the app is backgrounded,
                 mirroring MainActivity's identical filter. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".GeofenceReceiver" android:exported="false" />
        <!-- `phpx dev:push`'s trigger — non-exported, but `adb shell am
             broadcast -n` can still target it explicitly on a debuggable
             build, same as the two receivers above. See
             HotReloadReceiver.kt. -->
        <receiver android:name=".HotReloadReceiver" android:exported="false" />
    </application>
</manifest>
