<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one permission every consuming app needs unconditionally —
         PhpServer's embedded PHP process always talks to itself over
         127.0.0.1, and most screens make outbound HTTPS calls (Firebase
         Auth, OpenStreetMap tiles, translation model downloads). Every
         other capability's permission (camera, biometric, billing,
         geofencing, NFC, contacts, calendar, bluetooth...) is declared by
         the CONSUMING app instead, only for the capabilities it actually
         uses — the engine module itself doesn't assume any of them.
         Android's manifest merger unions this with whatever the app's own
         manifest adds. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Both activities are complete, launchable as-is — a consuming
             app references them directly by this fully-qualified name (see
             android/app/src/main/AndroidManifest.xml in this same repo for
             the reference shape: deep links, the dynamic-icon
             activity-alias, and any capability-specific permissions all
             live in the APP's own manifest, merged on top of this one). -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- NFC foreground dispatch (onResume/onPause) intercepts tag
                 scans before this filter ever matches while the app is in
                 front; TECH_DISCOVERED + NDEF catches any NDEF-formatted
                 tag without requiring a specific registered MIME type. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <activity
            android:name=".NativeRenderPocActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            <!-- OAuthProvider's browser-redirect flow (GitHub/Facebook/
                 Microsoft/Apple — see NativeDeviceBridge.kt's
                 startOAuthFlow()): a custom URI scheme, not an HTTPS App
                 Link, since the latter needs a verified domain a
                 scaffolded project may not have. android:launchMode=
                 "singleTask" above is what routes this back into the
                 SAME Activity instance the user was already using (via
                 onNewIntent()) instead of spawning a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phpnitro" android:host="oauth-callback" />
            </intent-filter>
            <!-- General deep link: phpnitro://product/42 -> screenStack
                 token "product/42" (see deepLinkScreenToken() in
                 NativeRenderPocActivity.kt) -> the exact same "name/param"
                 shape fetchDrawCommands() already splits for an in-app
                 navigate:product/42. A separate filter (not the
                 oauth-callback one above) since that one is pinned to a
                 single host; deepLinkScreenToken() itself excludes
                 host="oauth-callback" so the two never race on the same
                 URI. Scheme-only, no android:host, matches any host —
                 same "no verified domain available in this environment"
                 tradeoff MainActivity's own deep link takes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phpnitro" />
            </intent-filter>
        </activity>

        <!-- adb-only proof of concept — see RustRenderPocActivity.kt's own
             docblock for why this is a separate activity/file rather than
             a change to NativeCanvasView.kt or NativeRenderPocActivity
             above. No intent-filter beyond the implicit default: this is
             never a consuming app's launcher, only ever reached via
             `adb shell am start -n <package>/com.phpnitro.engine.RustRenderPocActivity`. -->
        <activity
            android:name=".RustRenderPocActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true" />

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".GeofenceReceiver" android:exported="false" />
        <!-- `phpx dev:push`'s trigger — non-exported, but `adb shell am
             broadcast -n` can still target it explicitly on a debuggable
             build. See HotReloadReceiver.kt. -->
        <receiver android:name=".HotReloadReceiver" android:exported="false" />

        <!-- Engine\Device\WebSocket — a real persistent connection that
             survives this app being backgrounded, which Android only
             allows from a declared foreground service (not a plain
             Activity-owned background thread). android:foregroundServiceType
             ="dataSync" is mandatory from API 34 and must match one of the
             OS's fixed categories — a live network connection is data
             sync, not media/location/camera/etc. See WebSocketService.kt's
             own docblock and android/app's manifest for the matching
             FOREGROUND_SERVICE/FOREGROUND_SERVICE_DATA_SYNC permissions
             (declared there, not here, same "capability-specific
             permission belongs to the consuming app" split every other
             optional capability already takes). -->
        <service
            android:name=".WebSocketService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Engine\Device\OpenFile — a content:// Uri is the only way to
             hand another app (whatever resolves the file's MIME type) a
             file living in this app's own storage; a raw file:// path is
             rejected across app boundaries since API 24. ${applicationId}
             resolves to the consuming app's own package at merge time, so
             this authority never collides between two PhpNitro apps
             installed side by side on the same device. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
