{
    "main": "bin/phpx",
    "output": "phpx.phar",
    "compression": "GZ",
    "chmod": "0755",
    "exclude-composer-files": false,
    "directories": [
        "lib",
        "packages",
        "android",
        "ios",
        "assets",
        "public",
        "vendor"
    ],
    "files": [
        ".env",
        "composer.json",
        "package.json",
        "package-lock.json",
        "phpnitro.yml"
    ],
    "blacklist": [
        "box.json",
        "phpstan.neon.dist",
        "phpunit.xml",
        "README.md"
    ]
}
